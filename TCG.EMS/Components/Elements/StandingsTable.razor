@implements IDisposable
@using TCG.Application.Interfaces.Services

<table class="table table-striped" style="table-layout: fixed; width: 100%;">
    <thead>
        <tr>
            <th>Player</th>
            <th>Points</th>
            <th>Wins</th>
            <th>Draws</th>
            <th>Losses</th>
            @if (_tournamentGame == "mtg")
            {
                <th>Op Match %</th>
                <th>Game Win %</th>
                <th>Op Game %</th>
            }
            else if (_tournamentGame == "pkmn")
            {
                <th>Op Match %</th>
                <th>Op Op Match %</th>
            }
        </tr>
    </thead>

    <tbody>
        @* Render all active players sorted by position, then disqualified players *@

        @if (_computedStats != null && _computedStats.Count > 0)
        {
            @* Get all players who are not disqualified, sorted by their ranking position *@
            var allActive = _computedStats
                .Where(p => !p.Value.IsDisqualified)
                .OrderBy(p => p.Value.Position)
                .Select(p => p.Value);

            @* Display each active player with their stats *@
            foreach (var player in allActive)
            {
                @* Show "(Dropped)" label for players who dropped out *@
                var statusSuffix = player.IsDropped ? " (Dropped)" : "";
                @* Apply muted styling to dropped players *@
                var rowClass = player.IsDropped ? "text-muted" : "";

                <tr class="@rowClass">
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">@(player.PlayerName ?? "Unknown")@statusSuffix</td>
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.MatchPoints</td>
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.Wins</td>
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.Draws</td>
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.Losses</td>
                    @if (_tournamentGame == "mtg")
                    {
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.OpMatchWinPercent.ToString("0.00")</td>
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.GameWinPercent.ToString("0.00")</td>
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.OpGameWinPercent.ToString("0.00")</td>
                    }
                    else if (_tournamentGame == "pkmn")
                    {
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.OpMatchWinPercent.ToString("0.00")</td>
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@player.OpOpMatchWinPercent.ToString("0.00")</td>
                    }
                </tr>
            }

            @* Get all disqualified players and display them separately in red *@
            var disqualified = _computedStats
                .Where(p => p.Value.IsDisqualified)
                .Select(p => p.Value);

            foreach (var player in disqualified)
            {
                <tr class="text-danger">
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">@(player.PlayerName ?? "Unknown") (Disqualified)</td>
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                    <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                    @if (_tournamentGame == "mtg")
                    {
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                    }
                    else if (_tournamentGame == "pkmn")
                    {
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                    }
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Inject]
    private ITournamentScoringService ScoringService { get; set; } = null!;

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Parameter]
    public int TournamentId { get; set; } = new();

    // If true, the component will automatically poll for updates every 30 seconds
    // Set to true only for real-time tournament viewing pages (e.g., spectator view)
    [Parameter]
    public bool RealTimeUpdate { get; set; }

    // Refresh key to trigger a refresh of the standings
    [Parameter]
    public int RefreshKey { get; set; }

    // Stores the computed player stats
    private Dictionary<int, ITournamentScoringService.PlayerComputedStats> _computedStats = new();

    // Stores the tournament game type ("mtg" or "pkmn")
    private string _tournamentGame = "";

    private PeriodicTimer? _timer;

    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        // Load tournament game type
        var tournament = await TournamentService.GetByIdAsync(TournamentId);
        _tournamentGame = tournament?.TournamentGame ?? "";

        if (RealTimeUpdate)
        {
            // Set up a background task to poll for updates every 30 seconds
            _cts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));

            // Start the polling loop
            await PollForUpdatesAsync(_cts.Token);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload standing data
        await RebuildPlayerListsAsync();
    }

    // Updates display every 30 secs
    private async Task PollForUpdatesAsync(CancellationToken token)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(token))
            {
                var standingsList = await ScoringService.ComputeTournamentStandings(TournamentId);
                _computedStats = standingsList ?? new Dictionary<int, ITournamentScoringService.PlayerComputedStats>();

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RebuildPlayerListsAsync()
    {
        var standingsList = await ScoringService.ComputeTournamentStandings(TournamentId);
        _computedStats = standingsList ?? new Dictionary<int, ITournamentScoringService.PlayerComputedStats>();
    }

    // Clean up resources when the component is done
    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}


