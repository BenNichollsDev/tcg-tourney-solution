@page "/tournaments/results/{tournamentId:int}"
@using TCG.Application.Dtos
@using TCG.Application.Services
@using TCG.EMS.Components.Elements

@rendermode InteractiveServer

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="bg-container p-4">
                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h1 class="mb-3 text-center">Final Results - @_tournamentModel.TournamentName</h1>

                    <div class="mb-3">
                        <strong>1st:</strong> @(_firstPlace ?? "N/A")<br />
                        <strong>2nd:</strong> @(_secondPlace ?? "N/A")<br />
                        @if (!string.IsNullOrEmpty(_thirdPlace))
                        {
                            <strong>3rd:</strong> @(_thirdPlace)
                        }
                    </div>

                    <table class="table table-striped" style="table-layout: fixed; width: 100%;">
                        <thead>
                            <tr>
                                <th>Position</th>
                                <th>Player</th>
                                <th>Points</th>
                                <th>Wins</th>
                                <th>Draws</th>
                                <th>Losses</th>
                                <th>Op Win%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_rankedStats != null)
                            {
                                var map = _participants.ToDictionary(x => x.TournamentPlayerId);

                                // Display all active and dropped players in ranking position order
                                var allRanked = _rankedStats
                                    .Where(s => map.ContainsKey(s.TournamentPlayerId) && !map[s.TournamentPlayerId].TpDisqualified)
                                    .OrderBy(s => s.Position);

                                var disqualified = _participants
                                    .Where(p => p.TpDisqualified)
                                    .OrderByDescending(p => p.PlayerName);

                                foreach (var s in allRanked)
                                {
                                    var p = map[s.TournamentPlayerId];
                                    var statusSuffix = p.TpDropped ? " (Dropped)" : "";

                                    <tr class="@(p.TpDropped ? "text-muted" : "")">
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@s.Position</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@p.PlayerName@statusSuffix</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@s.MatchPoints</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@s.Wins</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@s.Draws</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@s.Losses</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@s.OpMatchWinPercent.ToString("00.00")</td>
                                    </tr>
                                }

                                foreach (var p in disqualified)
                                {
                                    <tr class="text-danger">
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">-</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">@p.PlayerName (Disqualified)</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                                        <td style="word-wrap: break-word; overflow-wrap: break-word;">N/A</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <div class="mt-3">
                        <NavLink class="btn btn-outline-dark" href="/tournaments">Back</NavLink>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool _hasLoaded = false;
    private bool _showNull = false;

    private TournamentDto _tournamentModel = new();
    private List<TournamentPlayerDto> _participants = new();

    private List<ITournamentScoringService.PlayerComputedStats> _rankedStats = new();

    private string? _firstPlace;
    private string? _secondPlace;
    private string? _thirdPlace;

    [Parameter]
    public int? tournamentId { get; set; }

    [Inject]
    private ITournamentService TournamentService { get; set; } = default!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = default!;

    [Inject]
    private TournamentScoringService ScoringService { get; set; } = default!;

    // This initialises the page, computes rankings and saves positions to the database.
    protected override async Task OnInitializedAsync()
    {
        _hasLoaded = false;

        if (tournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(tournamentId.Value);
        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _participants = (await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == tournamentId.Value)).ToList();

        // Compute standings from the scoring service - it handles all tiebreaking logic
        var standingsList = await ScoringService.ComputeTournamentStandings(tournamentId.Value);
        var computed = standingsList.FirstOrDefault() ?? new Dictionary<int, ITournamentScoringService.PlayerComputedStats>();

        // Get all players sorted by position (the scoring service already resolves ties)
        var ordered = computed.Values.OrderBy(p => p.Position).ToList();

        // Save positions back to tournament players
        foreach (var s in ordered)
        {
            var tp = _participants.FirstOrDefault(x => x.TournamentPlayerId == s.TournamentPlayerId);
            if (tp != null)
            {
                tp.TpPosition = s.Position;
                await TournamentPlayerService.UpdateAsync(tp);
            }
        }

        _rankedStats = ordered;

        // Fill top three (skip disqualified and dropped)
        var map = _participants.ToDictionary(x => x.TournamentPlayerId);
        var podium = _rankedStats.Where(s => map.ContainsKey(s.TournamentPlayerId)
            && !map[s.TournamentPlayerId].TpDisqualified &&
            !map[s.TournamentPlayerId].TpDropped)
            .OrderBy(s => s.Position)
            .ToList();

        if (podium.Count >= 1) _firstPlace = map[podium[0].TournamentPlayerId].PlayerName;
        if (podium.Count >= 2) _secondPlace = map[podium[1].TournamentPlayerId].PlayerName;
        if (podium.Count >= 3) _thirdPlace = map[podium[2].TournamentPlayerId].PlayerName;

        _hasLoaded = true;
    }
}
