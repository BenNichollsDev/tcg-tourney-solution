@page "/tournaments"

@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using TCG.Application.Interfaces
@using TCG.Application.DTOs
@using TCG.Application.Dtos
@using TCG.Application.Interfaces.Services
@using TCG.Domain.Entities
@using TCG.EMS.Interfaces

@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
            <div class="bg-container p-4">

                <h1 class="mb-3">Tournaments</h1>

                @if (!_hasDataLoaded)
                {
                    <p>Loading...</p>
                }
                else
                {
                    @if (_tournaments!.Count == 0)
                    {
                        <p>No tournaments to list</p>
                        
                        <NavLink href="/tournaments/new" class="btn btn-primary mt-3">
                            <i class="bi bi-check"></i>Create a Tourney
                        </NavLink>
                    }
                    else
                    {
                        <NavLink href="/tournaments/new" class="btn btn-primary mt-3">
                            <i class="bi bi-check"></i>Create a Tourney
                        </NavLink>
                        
                        <div class="container-fluid me-4 mt-2 mb-2">

                            <div class="row mb-3 border-bottom border-2 border-light">
                                <div class="col-1 border-end border-1 border-light">
                                    <span>Status</span>
                                </div>
                                <div class="col-2 border-end border-1 border-light">
                                    <span>League</span>
                                </div>
                                <div class="col-1 border-end border-1 border-light">
                                    <span>Game</span>
                                </div>
                                <div class="col-2 border-end border-1 border-light">
                                    <span>Name</span>
                                </div>
                                <div class="col-1 border-end border-1 border-light">
                                    <span>Format</span>
                                </div>
                                <div class="col-1 border-end border-1 border-light">
                                    <span>Date</span>
                                </div>
                                <div class="col-1">
                                    <span>Time</span>
                                </div>
                                <div class="col-1">
                                    <span>

                                    </span>
                                </div>
                                <div class="col-1">
                                </div>
                            </div>

                            @foreach (var tournament in _tournaments!)
                            {
                                <div class="row mb-1">
                                    <div class="col-1 border-end border-1 border-light">
                                        @if (_tournamentModel.TournamentCancelled)
                                        {
                                            <span class="text-bg-info">CANCELLED</span>
                                        }
                                        else if (_tournamentModel.TournamentFinished)
                                        {
                                            <span class="">Finished</span>
                                        }
                                        else if (_tournamentModel.TournamentRoundInProgress)
                                        {
                                            <span class="">Round In Progress</span>
                                        }
                                        else if (_tournamentModel.TournamentStarted)
                                        {
                                            <span class="">Tournament In Progress</span>
                                        }
                                        else if (_tournamentModel.TournamentDate.ToDateTime(_tournamentModel.TournamentTime)
                                            <= DateTime.Now.AddMinutes(-15))
                                        {
                                            <span class="">OVERDUE</span>
                                        }
                                        else
                                        {
                                            <span class="">Not Started Yet</span>
                                        }
                                    </div>
                                    <div class="col-2 border-end border-1 border-light">
                                        <span>
                                            @(tournament.TournamentLeague.HasValue 
                                                ? _leagueLookup.GetValueOrDefault(tournament.TournamentLeague.Value)?.LeagueName 
                                                : "N/A")
                                        </span>
                                    </div>
                                    <div class="col-1 border-end border-1 border-light">
                                        <span>@tournament.TournamentGame</span>
                                    </div>
                                    <div class="col-2 border-end border-1 border-light">
                                        <span>@tournament.TournamentName</span>
                                    </div>
                                    <div class="col-1 border-end border-1 border-light">
                                        <span>@tournament.TournamentFormat</span>
                                    </div>
                                    <div class="col-1 border-end border-1 border-light">
                                        <span>@tournament.TournamentDate</span>
                                    </div>
                                    <div class="col-1 border-end border-1 border-light">
                                        <span>@tournament.TournamentTime</span>
                                    </div>
                                    <div class="col-1">
                                        @if (!_tournamentModel.TournamentStarted)
                                        {
                                            <NavLink href="@($"/tournaments/view/{tournament.TournamentId}")" class="btn btn-primary">
                                                View Details
                                            </NavLink>
                                        }
                                        else if (_tournamentModel.TournamentRoundInProgress)
                                        {
                                            <NavLink href="@($"/tournaments/inprogress/{tournament.TournamentId}")" class="btn btn-primary">
                                                Resume Rounds
                                            </NavLink>
                                        }
                                        else if (_tournamentModel.TournamentStarted)
                                        {
                                            <NavLink href="@($"/tournaments/results/{tournament.TournamentId}")" class="btn btn-primary">
                                                View Results
                                            </NavLink>
                                        }
                                    </div>
                                    <div class="col-1">
                                        <NavLink href="@($"/tournaments/edit/{tournament.TournamentId}")" class="btn btn-secondary">
                                            Add Players/Edit
                                        </NavLink>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
</div>

@code {
    private TournamentDto _tournamentModel = new();
    private bool _hasDataLoaded = false;

    [Inject]
    private ITournamentService TournamentService { get; set; } = default!;
    
    [Inject]
    private ILeagueService LeagueService { get; set; } = default!;

    List<TournamentDto>? _tournaments;
    
    private Dictionary<int, LeagueDto> _leagueLookup = new();

    protected override async Task OnInitializedAsync()
    {
        _tournaments = (List<TournamentDto>?)await TournamentService.GetAllAsync();

        var leagues = await LeagueService.GetAllAsync();
        _leagueLookup = leagues.ToDictionary(league => league.LeagueId);

        _hasDataLoaded = true;
    }
}