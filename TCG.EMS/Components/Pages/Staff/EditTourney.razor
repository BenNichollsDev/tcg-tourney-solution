@page "/tournaments/edit/{tournamentId:int}"

@using TCG.Application.Interfaces
@using TCG.Application.Dtos
@using TCG.Application.Interfaces.Services
@using TCG.Domain.Entities
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Web

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-8">
            <div class="bg-container p-4">

                @if (_notice != null)
                {
                    <div class="alert alert-warning">
                        @_notice
                    </div>
                }
                
                <h1 class="mb-3 text-center">Edit Tournament</h1>
                
                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <EditForm Model="@_tournamentModel" OnValidSubmit="OnFormSubmit" style="padding-left: 5em; padding-right: 5em; ">
                        <DataAnnotationsValidator />

                        <label for="name">Name:</label>
                        <InputText id="name"
                                   class="form-control mb-3"
                                   @bind-Value="_tournamentModel!.TournamentName"
                                   disabled="@_isReadOnly" />


                        <div class="participants-panel">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="mb-0">Add Participants</h4>
                                <div class="participants-count small text-muted" style="color:white">Players: <strong>@_participants.Count</strong> / @_tournamentModel.TournamentMaxParticipants</div>
                            </div>

                            <div class="d-flex mb-3">
                                <input id="participantInput" @ref="_participantInputRef" class="form-control me-2"
                                       placeholder="Enter participant name"
                                       @bind="_newParticipantName"
                                       disabled="@_isReadOnly"
                                       @onkeyup="HandleParticipantKeyUp"
                                       onkeydown="if(event.key==='Enter'){ event.preventDefault(); }" />

                                <button type="button"
                                        class="btn btn-primary"
                                        @onclick="AddParticipantAndFocus"
                                        disabled="@((_tournamentModel != null &&
                                            _participants.Count >= _tournamentModel.TournamentMaxParticipants)
                                            || _isReadOnly)">
                                    Add
                                </button>
                            </div>

                            @if (!string.IsNullOrEmpty(_participantErrorMessage))
                            {
                                <div class="text-danger mb-3">@_participantErrorMessage</div>
                            }

                            @if (_participants.Count > 0)
                            {
                                <div class="participants-list mb-0">
                                    @for (int i = 0; i < _participants.Count; i++)
                                    {
                                        var p = _participants[i];
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <span class="flex-grow-1">@p.PlayerName</span>
                                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveParticipant(p)" disabled="@_isReadOnly">Delete</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>


                        <label for="league">League:</label>
                        <InputSelect id="league"
                                     class="form-control mb-3"
                                     @bind-Value="_tournamentModel.TournamentLeague"
                                     disabled="@_isReadOnly">

                            <option value="">-- Select League --</option>

                            @foreach (var league in _leagues)
                            {
                                <option value="@league.LeagueId">
                                    @league.LeagueName
                                </option>
                            }

                        </InputSelect>

                        <label for="games">Game:</label>
                        <InputSelect id="games"
                                     class="form-control mb-3"
                                     @bind-Value="_tournamentModel.TournamentGame"
                                     @bind:after="OnGameChanged"
                                     disabled="@_isReadOnly">

                            <option value="">-- Select --</option>
                            <option value="mtg">Magic the Gathering</option>
                            <option value="pkmn">Pokémon</option>
                        </InputSelect>

                        <label for="formats">Format:</label>
                        <InputSelect id="formats"
                                     @key="_tournamentModel.TournamentGame"
                                     class="form-control mb-3"
                                     @bind-Value="_tournamentModel.TournamentFormat"
                                     @bind:after="OnFormatChanged"
                                     disabled="@_isReadOnly">

                            @if (!string.IsNullOrEmpty(_tournamentModel.TournamentGame))
                            {
                                <option value="">-- Select Format --</option>
                                @foreach (var f in _formatsByGame.First(g => g.Key == _tournamentModel.TournamentGame).Value)
                                {
                                    <option value="@f.Key">@f.Value["name"]</option>
                                }
                            }
                            else
                            {
                                <option value="">-- Select Game First --</option>
                            }
                        </InputSelect>

                        @if (_tournamentModel.TournamentFormat != "draft" && !string.IsNullOrEmpty(_tournamentModel.TournamentFormat))
                        {
                            <div class="d-flex align-items-center mb-3">
                                <label for="decklist" class="mb-0">Require a Decklist?</label>
                                <InputCheckbox id="decklist"
                                               class="form-check-input ms-2"
                                               @bind-Value="_tournamentModel.TournamentRequireDeck"
                                               disabled="@_isReadOnly" />
                            </div>
                        }

                        <label for="pairing">Pairing Type:</label>
                        <InputSelect id="pairing"
                                     class="form-control mb-3"
                                     @bind-Value="_tournamentModel.TournamentPairing"
                                     @bind:after="OnPairingChanged"
                                     disabled="@_isReadOnly">

                            <option value="">-- Select Pairing --</option>
                            <option value="Round-Robin">Round-Robin</option>
                            <option value="Swiss">Swiss</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => _tournamentModel.TournamentPairing)" />

                        <label for="tourneydate">Date:</label>
                        <input type="date" id="tourneydate" class="form-control mb-3"
                               value='@_tournamentModel.TournamentDate.ToString("yyyy-MM-dd")'
                               min="@MinDateString"
                               @onchange="OnDateInputChanged"
                               disabled="@_isReadOnly" />

                        <label for="tourneytime">Time:</label>
                        <input type="time" id="tourneytime" class="form-control mb-3"
                               value='@_tournamentModel.TournamentTime.ToString("HH:mm")'
                               min="@(IsDateToday ? MinTimeString : string.Empty)"
                               @onchange="OnTimeInputChanged"
                               disabled="@_isReadOnly" />

                        <label for="playernum">Max Number of Players:</label>

                        <InputNumber id="playernum"
                                     class="form-control mb-3"
                                     @bind-Value="_tournamentModel.TournamentMaxParticipants"
                                     min="2"
                                     required
                                     disabled="@_isReadOnly" />

                        <ValidationMessage For="@(() => _tournamentModel.TournamentMaxParticipants)" />

                        <label for="playernum">Max Number of Rounds:</label>

                        <InputNumber id="maxroundnum"
                                     class="form-control mb-3"
                                     @key="nameof(_tournamentModel.TournamentMaxRoundNum)"
                                     @bind-Value="_tournamentModel.TournamentMaxRoundNum"
                                     min="1"
                                     required
                                     disabled="@_isReadOnly" />

                        <label for="price">Entry Fee (£):</label>

                        <InputNumber id="price"
                                     class="form-control mb-3"
                                     step="0.01"
                                     @bind-Value="_tournamentModel.TournamentEntryFee"
                                     @bind:after="OnPriceInputChanged"
                                     disabled="@_isReadOnly" />

                        <label for="description">Description:</label>

                        <InputTextArea id="description"
                                       class="form-control mb-3"
                                       @bind-Value="_tournamentModel.TournamentDescription"
                                       disabled="@_isReadOnly" />

                        

                        <div>
                            <button type="submit" class="btn btn-primary"
                                disabled="@_isReadOnly">
                                Save Changes
                            </button>

                            <button type="submit" class="btn btn-primary"
                                    disabled="@_isReadOnly">
                                Delete Tournament
                            </button>

                            <button type="submit" class="btn btn-primary"
                                    disabled="@(!_canBeCancelled)">
                                Cancel Tournament
                            </button>
                        </div>

                        <div>
                            <NavLink href="/tournaments" type="button" class="btn btn-secondary">
                                Back
                            </NavLink>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _newParticipantName = string.Empty;

    private List<TournamentPlayerDto> _participants = new();
    private List<TournamentPlayerDto> _originalParticipants = new();

    private const string SwissValue = "Swiss";
    private const string RoundRobinValue = "Round-Robin";

    private bool _hasLoaded;
    private bool _showNull;
    private string? _notice;

    public int TournamentLeagueId { get; set; }
    public string? TournamentLeague { get; set; }

    private string _participantErrorMessage = string.Empty;

    private bool _isReadOnly;
    private bool _canBeCancelled;

    [Parameter]
    public int? TournamentId { get; set; }

    private TournamentDto? _tournamentModel = new();

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;

    [Inject]
    private ILeagueService LeagueService { get; set; } = default!;

    private List<LeagueDto> _leagues = new();

    private readonly Dictionary<string, Dictionary<string, Dictionary<string, string>>> _formatsByGame = new()
    {
        ["mtg"] = new Dictionary<string, Dictionary<string, string>>
        {
            ["Standard"] = new Dictionary<string, string>
            {
                ["name"] = "Constructed - Standard",
                ["pairing"] = SwissValue
            },
            ["Draft"] = new Dictionary<string, string>
            {
                ["name"] = "Limited - Draft",
                ["pairing"] = RoundRobinValue
            }
        },
        ["pkmn"] = new Dictionary<string, Dictionary<string, string>>
        {
            ["Standard"] = new Dictionary<string, string>
            {
                ["name"] = "Standard",
                ["pairing"] = SwissValue
            },
            ["Draft"] = new Dictionary<string, string>
            {
                ["name"] = "Booster Draft",
                ["pairing"] = RoundRobinValue
            }
        }
    };

    protected override void OnInitialized()
    {
        _hasLoaded = false;
        _showNull = false;
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        if (TournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);
        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _canBeCancelled = false;

        if (_tournamentModel.TournamentStarted)
        {
            _notice = "This tournament is currently in progress and details cannot be modified.";
            _isReadOnly = true;
            _canBeCancelled = true;
        }
        else if (_tournamentModel.TournamentFinished)
        {
            _notice = "This tournament has finished and details cannot be modified.";
            _isReadOnly = true;
            _canBeCancelled = false;
        }
        else if (_tournamentModel.TournamentCancelled)
        {
            _notice = "This tournament has been cancelled and details cannot be modified.";
            _isReadOnly = true;
            _canBeCancelled = false;
        }

        var allPlayers = await TournamentPlayerService.GetAllAsync();
        _participants = allPlayers.Where(p => p.TournamentId == TournamentId.Value).ToList();

        _originalParticipants = _participants.Select(p => new TournamentPlayerDto
        {
            TournamentPlayerId = p.TournamentPlayerId,
            TournamentId = p.TournamentId,
            PlayerName = p.PlayerName
        }).ToList();

        _leagues = (await LeagueService.GetAllAsync()).ToList();
        
        _hasLoaded = true;
    }
    
    // This adds a participant when the Add button is pressed. It checks simple validations.
    private void AddParticipant()
    {
        if (string.IsNullOrWhiteSpace(_newParticipantName) || _tournamentModel == null)
            return;

        if (_participants.Count >= _tournamentModel.TournamentMaxParticipants)
        {
            _participantErrorMessage =
                $"This tournament has reached its maximum of {_tournamentModel.TournamentMaxParticipants} players.";
            return;
        }

        var trimmedName = _newParticipantName.Trim();

        if (_participants.Any(p =>
                string.Equals(p.PlayerName, trimmedName, StringComparison.OrdinalIgnoreCase)))
        {
            _participantErrorMessage = "A participant with this name already exists.";
            return;
        }

        _participantErrorMessage = string.Empty;

        _participants.Add(new TournamentPlayerDto
        {
            TournamentId = _tournamentModel.TournamentId,
            PlayerName = trimmedName
        });

        _newParticipantName = string.Empty;
    }

    private ElementReference _participantInputRef;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    private async Task AddParticipantAndFocus()
    {
        AddParticipant();

        try
        {
            await _participantInputRef.FocusAsync();
        }
        catch
        {
            try
            {
                await JS.InvokeVoidAsync("eval", "document.getElementById('participantInput').focus()");
            }
            catch
            {
            }
        }
        StateHasChanged();
    }

    private async Task HandleParticipantKeyUp(KeyboardEventArgs e)
    {
        if (e?.Key == "Enter")
        {
            AddParticipant();

            try
            {
                await _participantInputRef.FocusAsync();
            }
            catch
            {
                try
                {
                    await JS.InvokeVoidAsync("eval", "document.getElementById('participantInput').focus()");
                }
                catch { }
            }
            StateHasChanged();
        }
    }

    // This removes a participant from the local list.
    private void RemoveParticipant(TournamentPlayerDto player)
    {
        _participants.Remove(player);
    }

    private void OnGameChanged(ChangeEventArgs e)
    {
        _tournamentModel.TournamentGame = e?.Value as string ?? string.Empty;
        _tournamentModel.TournamentFormat = string.Empty;

        StateHasChanged();
    }

    private void OnPairingChanged(ChangeEventArgs e)
    {
        StateHasChanged();
    }

    private void OnDateInputChanged(ChangeEventArgs e)
    {
        if (e?.Value is string s && DateOnly.TryParse(s, out var d))
        {
            var today = DateOnly.FromDateTime(DateTime.Now);
            _tournamentModel.TournamentDate = d < today ? today : d;

            if (IsDateToday && _tournamentModel.TournamentTime < TimeOnly.FromDateTime(DateTime.Now))
            {
                _tournamentModel.TournamentTime = TimeOnly.FromDateTime(DateTime.Now);
            }
        }

        StateHasChanged();
    }

    private void OnTimeInputChanged(ChangeEventArgs e)
    {
        if (e?.Value is string s && TimeOnly.TryParse(s, out var t))
        {
            if (IsDateToday && t < TimeOnly.FromDateTime(DateTime.Now))
            {
                _tournamentModel.TournamentTime = TimeOnly.FromDateTime(DateTime.Now);
            }
            else
            {
                _tournamentModel.TournamentTime = t;
            }
        }

        StateHasChanged();
    }

    private void OnPriceInputChanged(ChangeEventArgs e)
    {
        if (e?.Value is decimal s)
        {
            _tournamentModel.TournamentEntryFee =
                s < 0 ? 0 : Math.Round(s, 2, MidpointRounding.AwayFromZero);
        }

        StateHasChanged();
    }

    // This runs when the format is changed while editing.
    // It sets pairing automatically and locks Drafts to Round-Robin.
    private void OnFormatChanged()
    {
        _tournamentModel.TournamentRequireDeck = false;

        if (!string.IsNullOrEmpty(_tournamentModel.TournamentGame)
            && !string.IsNullOrEmpty(_tournamentModel.TournamentFormat)
            && _formatsByGame.TryGetValue(_tournamentModel.TournamentGame, out var formats)
            && formats.TryGetValue(_tournamentModel.TournamentFormat, out var meta))
        {
            if (meta.TryGetValue("pairing", out var pairing))
            {
                _tournamentModel.TournamentPairing = pairing;
            }
        }

        // Ensure Draft formats always use Round-Robin pairing
        if (_tournamentModel.TournamentFormat == "Draft")
        {
            _tournamentModel.TournamentPairing = RoundRobinValue;
        }

        StateHasChanged();
    }

    private static string MinDateString =>
        DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd");

    private static string MinTimeString =>
        DateTime.Now.ToString("HH:mm");

    private bool IsDateToday =>
        _tournamentModel.TournamentDate == DateOnly.FromDateTime(DateTime.Now);

    private bool IsDraft => string.Equals(_tournamentModel?.TournamentFormat, "Draft", StringComparison.OrdinalIgnoreCase);

    private async Task OnFormSubmit()
    {
        if (_tournamentModel == null) return;

        //_tournamentModel.TournamentPairing = _formatsByGame[_tournamentModel?.TournamentGame!][_tournamentModel?.TournamentFormat!]["pairing"];

        await TournamentService.UpdateAsync(_tournamentModel);

        var removedPlayers = _originalParticipants
            .Where(op => _participants.All(p => p.TournamentPlayerId != op.TournamentPlayerId))
            .ToList();

        foreach (var player in removedPlayers)
        {
            await TournamentPlayerService.DeleteAsync(player.TournamentPlayerId);
        }

        foreach (var player in _participants)
        {
            player.TournamentId = _tournamentModel.TournamentId;

            if (player.TournamentPlayerId == 0)
            {
                await TournamentPlayerService.CreateAsync(player);
            }
            else
            {
                await TournamentPlayerService.UpdateAsync(player);
            }
        }

        _originalParticipants = _participants.Select(p => new TournamentPlayerDto
        {
            TournamentPlayerId = p.TournamentPlayerId,
            TournamentId = p.TournamentId,
            PlayerName = p.PlayerName
        }).ToList();

        NavService.GoTourney();
    }

    private async Task CancelTournamentAsync()
    {
        // Cancel tournament
        _tournamentModel.TournamentCancelled = true;

        await TournamentService.UpdateAsync(_tournamentModel);

        // Navigate to results page
        NavManager.NavigateTo($"/tournaments/results/{TournamentId}");
    }

    private async Task DeleteTournamentAsync()
    {
        await TournamentService.DeleteAsync(_tournamentModel.TournamentId);

        // Navigate to tournaments page
        NavManager.NavigateTo($"/tournaments/tournaments");
    }
}

