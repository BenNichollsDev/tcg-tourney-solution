@page "/tournaments/inprogress/{tournamentId:int}"
@using TCG.Application.Dtos
@using TCG.Domain.Entities
@using System
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager NavManager

@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-container p-4">

                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h3>@_tournamentModel.TournamentName</h3>

                    <h4>Round @_tournamentModel.TournamentRoundNum/@_tournamentModel.TournamentMaxRoundNum</h4>

                    @if (!string.IsNullOrEmpty(_validationErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>Error:</strong> @_validationErrorMessage
                        </div>
                    }

                    <br />

                    @foreach (var pairing in pairings)
                    {
                        <div class="mb-3 border p-2">
                            <div class="row align-items-center">
                                <div class="col">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>@pairing.Player1Name</span>
                                        <input type="number" @bind-value="pairing.Player1Score"
                                                     @bind-value:after="() => StateHasChanged()"
                                                     class="form-control form-control-sm ms-2"
                                                     style="width:4rem;"
                                                     min="0" max="3"
                                                     disabled="@(pairing.Player1ScoreAutoAssigned || IsPlayerInBye(pairing, true) || (pairing.Player2Score == 3 && pairing.Player1Score != 3))" />
                                    </div>
                                </div>
                                <div class="col text-center">
                                    vs
                                </div>
                                <div class="col">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>@pairing.Player2Name</span>
                                        <input type="number" @bind-value="pairing.Player2Score"
                                                     @bind-value:after="() => StateHasChanged()"
                                                     class="form-control form-control-sm ms-2"
                                                     style="width:4rem;"
                                                     min="0" max="3"
                                                     disabled="@(pairing.Player2ScoreAutoAssigned || IsPlayerInBye(pairing, false) || (pairing.Player1Score == 3 && pairing.Player2Score != 3))" />
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-sm btn-info" @onclick="() => SetDraw(pairing)" disabled="@IsBye(pairing)">
                                        Draw
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    <p></p>

                    <!-- Disqualify/Drop controls -->
                    <div class="mt-4 mb-3 d-flex gap-2 align-items-center">
                        <select class="form-select w-auto" @bind="_selectedToDisqualify">
                            <option value="">-- Select player to disqualify --</option>
                            @foreach (var p in GetAvailablePlayersForDisqualify())
                            {
                                <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                            }
                        </select>
                        <button class="btn btn-danger" @onclick="DisqualifyPlayerAsync" disabled="@string.IsNullOrEmpty(_selectedToDisqualify)">Disqualify</button>

                        <select class="form-select w-auto" @bind="_selectedToDrop">
                            <option value="">-- Select player to drop --</option>
                            @foreach (var p in GetAvailablePlayersForDrop())
                            {
                                <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                            }
                        </select>
                        <button class="btn btn-warning" @onclick="DropPlayerAsync" disabled="@string.IsNullOrEmpty(_selectedToDrop)">Drop</button>
                    </div>
                }

                <div class="mt-3 d-flex gap-2">

                    <button class="btn btn-primary"
                            @onclick="SaveResults">
                        Save Results
                    </button>

                    <button class="btn btn-secondary"
                            @onclick="BacktoPairings">
                        Back to Pairings
                    </button>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private class PairingSelection
    {
        public int? Player1Id { get; set; }
        public int? Player2Id { get; set; }

        public string? Player1Name { get; set; }
        public string? Player2Name { get; set; }
        public int Player1Score { get; set; }
        public int Player2Score { get; set; }

        // Track if a player's score was auto-assigned due to opponent disqualification/drop
        public bool Player1ScoreAutoAssigned { get; set; }
        public bool Player2ScoreAutoAssigned { get; set; }
    }

    private bool _hasLoaded;
    private bool _showNull;
    private List<PairingSelection> pairings = new();
    private string? _validationErrorMessage;
    private string? _selectedToDisqualify;
    private string? _selectedToDrop;
    private List<TournamentPlayerDto> _tournamentPlayers = new();

    [Parameter]
    public int? TournamentId { get; set; }

    private TournamentDto? _tournamentModel = new();

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;

    [Inject]
    private IPairingService PairingService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _hasLoaded = false;
        _showNull = false;

        if (TournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);

        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        // If tournament is NOT in progress, redirect to view page
        if (!_tournamentModel.TournamentRoundInProgress)
        {
            NavManager.NavigateTo($"/tournaments/view/{TournamentId}");
            return;
        }

        // Load pairings from database for the current round
        var dbPairings = (await PairingService
            .GetAllWhereAsync(p => p.TournamentId == TournamentId.Value && p.RoundNumber == _tournamentModel.TournamentRoundNum))
            .ToList();

        if (dbPairings.Any())
        {
            // Use pairings from database
            var allPlayers = (await TournamentPlayerService
                .GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value))
                .ToDictionary(tp => tp.TournamentPlayerId);

            foreach (var pairing in dbPairings)
            {
                var p1Name = "BYE";
                var p2Name = "BYE";

                if (allPlayers.TryGetValue(pairing.Player1Id, out var player1))
                {
                    p1Name = player1.PlayerName ?? "Unknown";
                }

                if (pairing.Player2Id.HasValue && allPlayers.TryGetValue(pairing.Player2Id.Value, out var player2))
                {
                    p2Name = player2.PlayerName ?? "Unknown";
                }

                // For bye pairings, ensure Player1 has score locked to 3
                int p1Score = pairing.Player1Score ?? 0;
                if (!pairing.Player2Id.HasValue)
                {
                    p1Score = 3;
                }

                pairings.Add(new PairingSelection
                {
                    Player1Id = pairing.Player1Id,
                    Player2Id = pairing.Player2Id,
                    Player1Name = p1Name,
                    Player2Name = p2Name ?? "BYE",
                    Player1Score = p1Score,
                    Player2Score = pairing.Player2Score ?? 0
                });
            }
        }
        else
        {
            // Fallback: construct from participant list (shouldn't normally reach here if pairings were saved)
            var allPlayers = (await TournamentPlayerService
                .GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value))
                .ToList();

            for (int i = 0; i < allPlayers.Count; i += 2)
            {
                var p1 = allPlayers[i];
                var p2 = i + 1 < allPlayers.Count ? allPlayers[i + 1] : null;

                pairings.Add(new PairingSelection
                {
                    Player1Id = p1.TournamentPlayerId,
                    Player2Id = p2?.TournamentPlayerId,
                    Player1Name = p1.PlayerName ?? "Unknown",
                    Player2Name = p2?.PlayerName ?? "BYE",
                    Player1Score = p2 == null ? 3 : 0,
                    Player2Score = 0
                });
            }
        }

        // Load all tournament players for disqualify/drop dropdowns
        _tournamentPlayers = (await TournamentPlayerService
            .GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value))
            .ToList();

        _hasLoaded = true;
    }

    private static bool IsValidPairingResult(PairingSelection pairing)
    {
        // Auto-assigned wins (from drop/disqualify) are always valid
        if (pairing.Player1ScoreAutoAssigned || pairing.Player2ScoreAutoAssigned)
            return true;

        // Bye pairings are always valid
        if (!pairing.Player2Id.HasValue)
            return true;

        int p1Score = pairing.Player1Score;
        int p2Score = pairing.Player2Score;

        // Valid scenario 1: Player 1 has 3, Player 2 has 0-2
        if (p1Score == 3 && p2Score <= 2)
            return true;

        // Valid scenario 2: Player 2 has 3, Player 1 has 0-2
        if (p2Score == 3 && p1Score <= 2)
            return true;

        // Valid scenario 3: Both have 1 (draw)
        if (p1Score == 1 && p2Score == 1)
            return true;

        return false;
    }

    private bool AreAllPairingsValid()
    {
        _validationErrorMessage = null;

        foreach (var pairing in pairings)
        {
            if (!IsValidPairingResult(pairing))
            {
                _validationErrorMessage = $"Invalid result for {pairing.Player1Name} vs {pairing.Player2Name}. " +
                    "Each pairing must have either: one player with 3 points and the other with 0-2 points, or both players with 1 point (draw).";
                return false;
            }
        }

        return true;
    }

    private List<TournamentPlayerDto> GetAvailablePlayersForDisqualify()
    {
        var pairingPlayerIds = pairings
            .Where(p => p.Player1Id.HasValue || p.Player2Id.HasValue)
            .SelectMany(p => new[] { p.Player1Id, p.Player2Id })
            .Where(id => id.HasValue)
            .Select(id => id.Value)
            .ToHashSet();

        return _tournamentPlayers
            .Where(p => pairingPlayerIds.Contains(p.TournamentPlayerId) && !p.TpDisqualified)
            .ToList();
    }

    private List<TournamentPlayerDto> GetAvailablePlayersForDrop()
    {
        var pairingPlayerIds = pairings
            .Where(p => p.Player1Id.HasValue || p.Player2Id.HasValue)
            .SelectMany(p => new[] { p.Player1Id, p.Player2Id })
            .Where(id => id.HasValue)
            .Select(id => id.Value)
            .ToHashSet();

        return _tournamentPlayers
            .Where(p => pairingPlayerIds.Contains(p.TournamentPlayerId) && !p.TpDropped && !p.TpDisqualified)
            .ToList();
    }

    private void UpdatePairingsForRemovedPlayer(int playerId)
    {
        foreach (var pairing in pairings)
        {
            // Replace the removed player with null
            if (pairing.Player1Id == playerId)
            {
                pairing.Player1Id = null;
                pairing.Player1Name = "BYE";
                pairing.Player1Score = 0;
                pairing.Player1ScoreAutoAssigned = false;
            }
            if (pairing.Player2Id == playerId)
            {
                pairing.Player2Id = null;
                pairing.Player2Name = "BYE";
                pairing.Player2Score = 0;
                pairing.Player2ScoreAutoAssigned = false;
            }

            // If a player is left alone in the pairing, give them an automatic win (3 points)
            if (pairing.Player1Id.HasValue && !pairing.Player2Id.HasValue)
            {
                pairing.Player2Name = "BYE";
                pairing.Player2Score = 0;
                pairing.Player1Score = 3;
                pairing.Player1ScoreAutoAssigned = true;  // Mark as auto-assigned so it can't be edited
            }
            else if (!pairing.Player1Id.HasValue && pairing.Player2Id.HasValue)
            {
                // Move Player2 to Player1 and give them the automatic win
                pairing.Player1Id = pairing.Player2Id;
                pairing.Player1Name = pairing.Player2Name;
                pairing.Player1Score = 3;
                pairing.Player1ScoreAutoAssigned = true;
                pairing.Player2Id = null;
                pairing.Player2Name = "BYE";
                pairing.Player2Score = 0;
            }
        }

        // Remove empty pairings (both players null/bye)
        pairings.RemoveAll(p => !p.Player1Id.HasValue && !p.Player2Id.HasValue);
    }

    private static bool IsBye(PairingSelection p) =>
        !p.Player2Id.HasValue;

    private static bool IsPlayerInBye(PairingSelection p, bool isPlayer1)
    {
        if (!p.Player2Id.HasValue)
        {
            // This is a bye pairing - Player1 gets the bye, lock Player1's score to 3
            return isPlayer1;
        }
        return false;
    }

    private void SetDraw(PairingSelection pairing)
    {
        if (!IsBye(pairing))
        {
            pairing.Player1Score = 1;
            pairing.Player2Score = 1;
            StateHasChanged();
        }
    }

    private async Task DisqualifyPlayerAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedToDisqualify))
            return;

        if (!int.TryParse(_selectedToDisqualify, out var playerId))
            return;

        var tp = _tournamentPlayers.FirstOrDefault(p => p.TournamentPlayerId == playerId);
        if (tp == null)
            return;

        tp.TpDisqualified = true;
        await TournamentPlayerService.UpdateAsync(tp);

        // Update pairings immediately
        UpdatePairingsForRemovedPlayer(playerId);

        // Refresh tournament players list
        _tournamentPlayers = (await TournamentPlayerService
            .GetAllWhereAsync(tp => tp.TournamentId == TournamentId))
            .ToList();

        _selectedToDisqualify = null;
        StateHasChanged();
    }

    private async Task DropPlayerAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedToDrop))
            return;

        if (!int.TryParse(_selectedToDrop, out var playerId))
            return;

        var tp = _tournamentPlayers.FirstOrDefault(p => p.TournamentPlayerId == playerId);
        if (tp == null)
            return;

        tp.TpDropped = true;
        await TournamentPlayerService.UpdateAsync(tp);

        // Update pairings immediately
        UpdatePairingsForRemovedPlayer(playerId);

        // Refresh tournament players list
        _tournamentPlayers = (await TournamentPlayerService
            .GetAllWhereAsync(tp => tp.TournamentId == TournamentId))
            .ToList();

        _selectedToDrop = null;
        StateHasChanged();
    }

    private async Task SaveResults()
    {
        if (TournamentId == null || _tournamentModel == null)
            return;

        // Validate all pairings before saving
        if (!AreAllPairingsValid())
        {
            StateHasChanged();
            return;
        }

        var dbPairings = (await PairingService
            .GetAllWhereAsync(p => p.TournamentId == TournamentId.Value && p.RoundNumber == _tournamentModel.TournamentRoundNum))
            .ToList();

        foreach (var uiPairing in pairings)
        {
            if (uiPairing.Player1Id == null && uiPairing.Player2Id == null)
                continue;

            int? p1 = uiPairing.Player1Id;
            int? p2 = uiPairing.Player2Id;

            // Find matching pairing by checking current state and original state
            // If current P1 matches a db entry's P1 or P2, theres a match
            var dbPairing = dbPairings.FirstOrDefault(x =>
                (x.Player1Id == p1 && x.Player2Id == p2) ||
                (x.Player1Id == p1 && x.Player2Id == null) ||
                (x.Player1Id == p1 && p2 == null && x.Player2Id.HasValue) ||
                (x.Player2Id == p1 && p2 == null && x.Player1Id != null));

            if (dbPairing == null)
                continue;

            // Update pairing IDs if they changed due to disqual or drop
            dbPairing.Player1Id = p1 ?? dbPairing.Player1Id;
            dbPairing.Player2Id = p2;

            // Save results
            dbPairing.Player1Score = uiPairing.Player1Score;
            dbPairing.Player2Score = uiPairing.Player2Score;

            dbPairing.HasResult = true;

            // mark draw if both players have equal scores (e.g., 1-1)
            dbPairing.PairingDraw = uiPairing.Player1Score == uiPairing.Player2Score;

            await ApplyPlayerResults(uiPairing, dbPairing);
        }

        // Increment round
        _tournamentModel.TournamentRoundNum += 1;

        // Mark tournament as NOT in progress before updating
        _tournamentModel.TournamentRoundInProgress = false;

        await TournamentService.UpdateAsync(_tournamentModel);

        NavManager.NavigateTo($"/tournaments/view/{TournamentId}");
    }

    private async Task ApplyPlayerResults(PairingSelection uiPairing, PairingDto dbPairing)
    {
        await PairingService.UpdateAsync(dbPairing);

        // Handle bye: if Player2 is null (BYE), only update Player1
        if (uiPairing.Player1Id == null)
            return;

        // For bye matches: Player2 will be null
        if (uiPairing.Player2Id == null)
        {
            var p1 = await TournamentPlayerService.GetByIdAsync(uiPairing.Player1Id.Value);

            // Determine if Pokémon or MTG tournament
            bool isPokemon = string.Equals(_tournamentModel?.TournamentGame, "pkmn", StringComparison.OrdinalIgnoreCase);

            if (isPokemon)
            {
                // Pokémon: bye counts as 1 match played, 0 games played
                p1.MatchesPlayed = (p1.MatchesPlayed ?? 0) + 1;
                p1.PlayerBye = (p1.PlayerBye ?? 0) + 1;
            }
            else
            {
                // MTG: bye counts as 3 match points, 0 games played
                p1.PlayerSwissMatchPoints = (p1.PlayerSwissMatchPoints ?? 0) + 3;
                p1.PlayerSwissPoints = (p1.PlayerSwissPoints ?? 0) + 3;
                p1.PlayerBye = (p1.PlayerBye ?? 0) + 1;
            }

            await TournamentPlayerService.UpdateAsync(p1);
            return;
        }

        var p1Player = await TournamentPlayerService.GetByIdAsync(uiPairing.Player1Id.Value);
        var p2Player = await TournamentPlayerService.GetByIdAsync(uiPairing.Player2Id.Value);

        // Increment match count for both players
        p1Player.MatchesPlayed = (p1Player.MatchesPlayed ?? 0) + 1;
        p2Player.MatchesPlayed = (p2Player.MatchesPlayed ?? 0) + 1;

        // Increment game count for both players
        p1Player.GamesPlayed = (p1Player.GamesPlayed ?? 0) + 1;
        p2Player.GamesPlayed = (p2Player.GamesPlayed ?? 0) + 1;

        // Compute point deltas for match points / swiss points
        int p1GameDifference = 0;
        int p2GameDifference = 0;

        bool isRoundRobin = string.Equals(_tournamentModel?.TournamentFormat, "RoundRobin", StringComparison.OrdinalIgnoreCase);

        if (uiPairing.Player1Score > uiPairing.Player2Score)
        {
            p1Player.PlayerSwissWins = (p1Player.PlayerSwissWins ?? 0) + 1;
            p2Player.PlayerSwissLosses = (p2Player.PlayerSwissLosses ?? 0) + 1;

            if (isRoundRobin)
            {
                p1Player.PlayerRoundRobinGameWins = (p1Player.PlayerRoundRobinGameWins ?? 0) + 1;
                p2Player.PlayerRoundRobinGameLosses = (p2Player.PlayerRoundRobinGameLosses ?? 0) + 1;
            }
            else
            {
                p1Player.PlayerSwissGameWins = (p1Player.PlayerSwissGameWins ?? 0) + 1;
                p2Player.PlayerSwissGameLosses = (p2Player.PlayerSwissGameLosses ?? 0) + 1;
            }

            p1GameDifference = 3;
            p2GameDifference = 0;
        }
        else if (uiPairing.Player2Score > uiPairing.Player1Score)
        {
            p1Player.PlayerSwissLosses = (p1Player.PlayerSwissLosses ?? 0) + 1;
            p2Player.PlayerSwissWins = (p2Player.PlayerSwissWins ?? 0) + 1;

            if (isRoundRobin)
            {
                p1Player.PlayerRoundRobinGameLosses = (p1Player.PlayerRoundRobinGameLosses ?? 0) + 1;
                p2Player.PlayerRoundRobinGameWins = (p2Player.PlayerRoundRobinGameWins ?? 0) + 1;
            }
            else
            {
                p1Player.PlayerSwissGameLosses = (p1Player.PlayerSwissGameLosses ?? 0) + 1;
                p2Player.PlayerSwissGameWins = (p2Player.PlayerSwissGameWins ?? 0) + 1;
            }

            p1GameDifference = 0;
            p2GameDifference = 3;
        }
        else
        {
            p1Player.PlayerSwissDraws = (p1Player.PlayerSwissDraws ?? 0) + 1;
            p2Player.PlayerSwissDraws = (p2Player.PlayerSwissDraws ?? 0) + 1;

            if (isRoundRobin)
            {
                p1Player.PlayerRoundRobinGameDraws = (p1Player.PlayerRoundRobinGameDraws ?? 0) + 1;
                p2Player.PlayerRoundRobinGameDraws = (p2Player.PlayerRoundRobinGameDraws ?? 0) + 1;
            }
            else
            {
                p1Player.PlayerSwissGameDraws = (p1Player.PlayerSwissGameDraws ?? 0) + 1;
                p2Player.PlayerSwissGameDraws = (p2Player.PlayerSwissGameDraws ?? 0) + 1;
            }

            p1GameDifference = 1;
            p2GameDifference = 1;
        }

        // Update match points and swiss points
        p1Player.PlayerSwissMatchPoints = (p1Player.PlayerSwissMatchPoints ?? 0) + p1GameDifference;
        p2Player.PlayerSwissMatchPoints = (p2Player.PlayerSwissMatchPoints ?? 0) + p2GameDifference;

        p1Player.PlayerSwissPoints = (p1Player.PlayerSwissPoints ?? 0) + p1GameDifference;
        p2Player.PlayerSwissPoints = (p2Player.PlayerSwissPoints ?? 0) + p2GameDifference;

        await TournamentPlayerService.UpdateAsync(p1Player);
        await TournamentPlayerService.UpdateAsync(p2Player);
    }

    private async Task BacktoPairings()
    {
        if (TournamentId == null || _tournamentModel == null)
            return;

        var dbPairings = await PairingService
            .GetAllWhereAsync(p => p.TournamentId == TournamentId.Value);

        // Round is no longer in progress
        _tournamentModel.TournamentRoundInProgress = false;
        await TournamentService.UpdateAsync(_tournamentModel);

        NavManager.NavigateTo($"/tournaments/view/{TournamentId}");
    }
}

