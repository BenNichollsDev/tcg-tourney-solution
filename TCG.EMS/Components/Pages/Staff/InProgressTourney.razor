@page "/tournaments/inprogress/{tournamentId:int}"
@using TCG.Application.Dtos
@using TCG.Domain.Entities
@using System
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-container p-4">

                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h3>@_tournamentModel.TournamentName</h3>

                    <h4>Round @_tournamentModel.TournamentRoundNum/@_tournamentModel.TournamentMaxRoundNum</h4>

                    <br />

                    @foreach (var pairing in pairings)
                    {
                        <div class="mb-3 border p-2">
                            <div class="row">
                                <div class="col">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>@pairing.Player1Name</span>
                                        <InputNumber @bind-Value="pairing.Player1Score"
                                                     TValue="int"
                                                     class="form-control form-control-sm ms-2"
                                                     style="width:4rem;"
                                                     min="0" max="3"
                                                     disabled="@IsBye(pairing)" />
                                    </div>
                                </div>
                                <div class="col text-center">
                                    vs
                                </div>
                                <div class="col">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>@pairing.Player2Name</span>
                                        <InputNumber @bind-Value="pairing.Player2Score"
                                                     TValue="int"
                                                     class="form-control form-control-sm ms-2"
                                                     style="width:4rem;"
                                                     min="0" max="3"
                                                     disabled="@IsBye(pairing)" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    <p></p>
                }

                <div class="mt-3 d-flex gap-2">

                    <button class="btn btn-primary"
                            @onclick="SaveResults">
                        Save Results
                    </button>

                    <button class="btn btn-secondary"
                            @onclick="BacktoPairings">
                        Back to Pairings
                    </button>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private class PairingSelection
    {
        public int? Player1Id { get; set; }
        public int? Player2Id { get; set; }

        public string? Player1Name { get; set; }
        public string? Player2Name { get; set; }
        public int Player1Score { get; set; }
        public int Player2Score { get; set; }
    }

    private bool _hasLoaded;
    private bool _showNull;
    private List<PairingSelection> pairings = new();

    [Parameter]
    public int? TournamentId { get; set; }

    private TournamentDto? _tournamentModel = new();

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;

    [Inject]
    private IPairingService PairingService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _hasLoaded = false;
        _showNull = false;

        if (TournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);

        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        // If tournament is NOT in progress, redirect to view page
        if (!_tournamentModel.TournamentRoundInProgress)
        {
            NavManager.NavigateTo($"/tournaments/view/{TournamentId}");
            return;
        }

        // Load pairings from database for the current round
        var dbPairings = (await PairingService
            .GetAllWhereAsync(p => p.TournamentId == TournamentId.Value && p.RoundNumber == _tournamentModel.TournamentRoundNum))
            .ToList();

        if (dbPairings.Any())
        {
            // Use pairings from database
            var allPlayers = (await TournamentPlayerService
                .GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value))
                .ToDictionary(tp => tp.TournamentPlayerId);

            foreach (var pairing in dbPairings)
            {
                var p1Name = "BYE";
                var p2Name = "BYE";

                if (pairing.PairingTp1.HasValue && allPlayers.TryGetValue(pairing.PairingTp1.Value, out var player1))
                {
                    p1Name = player1.PlayerName ?? "Unknown";
                }

                if (pairing.PairingTp2.HasValue && allPlayers.TryGetValue(pairing.PairingTp2.Value, out var player2))
                {
                    p2Name = player2.PlayerName ?? "Unknown";
                }

                pairings.Add(new PairingSelection
                {
                    Player1Id = pairing.PairingTp1,
                    Player2Id = pairing.PairingTp2,
                    Player1Name = p1Name,
                    Player2Name = p2Name,
                    Player1Score = pairing.PairingPlayer1Score ?? 0,
                    Player2Score = pairing.PairingPlayer2Score ?? 0
                });
            }
        }
        else
        {
            // Fallback: construct from participant list (shouldn't normally reach here if pairings were saved)
            var allPlayers = (await TournamentPlayerService
                .GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value))
                .ToList();

            for (int i = 0; i < allPlayers.Count; i += 2)
            {
                var p1 = allPlayers[i];
                var p2 = i + 1 < allPlayers.Count ? allPlayers[i + 1] : null;

                pairings.Add(new PairingSelection
                {
                    Player1Id = p1.TournamentPlayerId,
                    Player2Id = p2?.TournamentPlayerId,
                    Player1Name = p1.PlayerName ?? "BYE",
                    Player2Name = p2?.PlayerName ?? "BYE",
                    Player1Score = 0,
                    Player2Score = 0
                });
            }
        }

        _hasLoaded = true;
    }

    private static bool IsBye(PairingSelection p) =>
        string.Equals(p.Player1Name, "BYE", StringComparison.OrdinalIgnoreCase)
        || string.Equals(p.Player2Name, "BYE", StringComparison.OrdinalIgnoreCase);

    private async Task SaveResults()
    {
        if (TournamentId == null || _tournamentModel == null)
            return;

        var dbPairings = (await PairingService
            .GetAllWhereAsync(p => p.TournamentId == TournamentId.Value && p.RoundNumber == _tournamentModel.TournamentRoundNum))
            .ToList();

        foreach (var uiPairing in pairings)
        {
            if (uiPairing.Player1Id == null)
                continue;

            int? p1 = uiPairing.Player1Id;
            int? p2 = uiPairing.Player2Id;

            var dbPairing = dbPairings.FirstOrDefault(x =>
                x.PairingTp1 == p1 &&
                x.PairingTp2 == p2);

            if (dbPairing == null)
                continue;

            // Save results
            dbPairing.PairingPlayer1Score = uiPairing.Player1Score;
            dbPairing.PairingPlayer2Score = uiPairing.Player2Score;

            dbPairing.PairingHasResult = true;

            await ApplyPlayerResults(uiPairing, dbPairing);
        }

        // Increment round
        _tournamentModel.TournamentRoundNum += 1;

        // Keep tournament NOT in progress (you return to view screen)
        _tournamentModel.TournamentRoundInProgress = false;

        await TournamentService.UpdateAsync(_tournamentModel);

        NavManager.NavigateTo($"/tournaments/view/{TournamentId}");
    }

    private async Task ApplyPlayerResults(PairingSelection uiPairing, PairingDto dbPairing)
    {
        await PairingService.UpdateAsync(dbPairing);

        if (uiPairing.Player1Id == null || uiPairing.Player2Id == null)
            return;

        var p1 = await TournamentPlayerService.GetByIdAsync(uiPairing.Player1Id.Value);
        var p2 = await TournamentPlayerService.GetByIdAsync(uiPairing.Player2Id.Value);

        if (uiPairing.Player1Score > uiPairing.Player2Score)
        {
            p1.PlayerSwissWins = (p1.PlayerSwissWins ?? 0) + 1;
            p2.PlayerSwissLosses = (p2.PlayerSwissLosses ?? 0) + 1;
        }
        else if (uiPairing.Player2Score > uiPairing.Player1Score)
        {
            p2.PlayerSwissWins = (p2.PlayerSwissWins ?? 0) + 1;
            p1.PlayerSwissLosses = (p1.PlayerSwissLosses ?? 0) + 1;
        }
        else
        {
            p1.PlayerSwissDraws = (p1.PlayerSwissDraws ?? 0) + 1;
            p2.PlayerSwissDraws = (p2.PlayerSwissDraws ?? 0) + 1;
        }

        await TournamentPlayerService.UpdateAsync(p1);
        await TournamentPlayerService.UpdateAsync(p2);
    }

    private async Task BacktoPairings()
    {
        if (TournamentId == null || _tournamentModel == null)
            return;

        var dbPairings = await PairingService
            .GetAllWhereAsync(p => p.TournamentId == TournamentId.Value);

        foreach (var pairing in dbPairings)
        {
            if (pairing.PairingId.HasValue)
                await PairingService.DeleteAsync(pairing.PairingId.Value);
        }

        // Round is no longer in progress
        _tournamentModel.TournamentRoundInProgress = false;
        await TournamentService.UpdateAsync(_tournamentModel);

        NavManager.NavigateTo($"/tournaments/view/{TournamentId}");
    }
}