@page "/home"
@using TCG.Application.Dtos
@using TCG.Application.Services
@using TCG.Application.Interfaces.Services

@inject NavigationManager NavManager

@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container-fluid py-4">
	<div class="row justify-content-center mb-4">
		<div class="col-auto">
			<h1 class="text-center">TCGTourneys | Dashboard</h1>
		</div>
	</div>

	<div class="row">
		<div class="col-lg-6 pe-0">
			<div class="bg-container p-4 h-100">
				<h4 class="mb-3">Tournaments</h4>

				@if (!_hasLoaded)
				{
					<p>Loading...</p>
				}
				else if (_upcoming == null || (_upcoming.Count == 0 && _ongoing.Count == 0))
				{
					<p>No tournaments found.</p>
				}
				else
				{
					<div class="container-fluid">
						@if (_upcoming != null && _upcoming.Count > 0)
						{
							<div class="mb-4">
								<h5 class="mb-2">Upcoming</h5>
								<div class="row mb-2 border-bottom border-2 border-light">
									<div class="col-3 border-end border-1 border-light">
										<span>Name</span>
									</div>
									<div class="col-3 border-end border-1 border-light">
										<span>Game</span>
									</div>
									<div class="col-2 border-end border-1 border-light">
										<span>Format</span>
									</div>
									<div class="col-2 border-end border-1 border-light">
										<span>Date</span>
									</div>
									<div class="col-2">
										<span>Time</span>
									</div>
								</div>

								@foreach (var tournament in _upcoming)
								{
									<div class="row mb-1 align-items-center tourney-card">
										<div class="col-3 border-end border-1 border-light">
											<span>@tournament.TournamentName</span>
										</div>
										<div class="col-3 border-end border-1 border-light">
											<span>@tournament.TournamentGame</span>
										</div>
										<div class="col-2 border-end border-1 border-light">
											<span>@tournament.TournamentFormat</span>
										</div>
										<div class="col-2 border-end border-1 border-light">
											<span>@tournament.TournamentDate</span>
										</div>
										<div class="col-2">
											<span>@tournament.TournamentTime</span>
										</div>
									</div>
								}
							</div>
						}

						@if (_ongoing != null && _ongoing.Count > 0)
						{
							<div>
								<h5 class="mb-2">Ongoing</h5>
								<div class="row mb-2 border-bottom border-2 border-light">
									<div class="col-3 border-end border-1 border-light">
										<span>Name</span>
									</div>
									<div class="col-3 border-end border-1 border-light">
										<span>Game</span>
									</div>
									<div class="col-2 border-end border-1 border-light">
										<span>Format</span>
									</div>
									<div class="col-2 border-end border-1 border-light">
										<span>Date</span>
									</div>
									<div class="col-2">
										<span>Time</span>
									</div>
								</div>

								@foreach (var tournament in _ongoing)
								{
									<div class="row mb-1 align-items-center tourney-card">
										<div class="col-3 border-end border-1 border-light">
											<span>@tournament.TournamentName</span>
										</div>
										<div class="col-3 border-end border-1 border-light">
											<span>@tournament.TournamentGame</span>
										</div>
										<div class="col-2 border-end border-1 border-light">
											<span>@tournament.TournamentFormat</span>
										</div>
										<div class="col-2 border-end border-1 border-light">
											<span>@tournament.TournamentDate</span>
										</div>
										<div class="col-2">
											<span>@tournament.TournamentTime</span>
										</div>
									</div>
								}
							</div>
						}
					</div>
				}
			</div>
		</div>

		<div class="col-lg-6 ps-0">
			<div class="bg-container p-4 h-100">
				<h4 class="mb-3">Leagues</h4>

				@if (!_hasLoaded)
				{
					<p>Loading...</p>
				}
				else if (_leagues == null || _leagues.Count == 0)
				{
					<p>No leagues found.</p>
				}
				else
				{
					<div class="container-fluid">
						<div class="row mb-2 border-bottom border-2 border-light">
							<div class="col-4 border-end border-1 border-light">
								<span>Name</span>
							</div>
							<div class="col-3 border-end border-1 border-light">
								<span>Game</span>
							</div>
							<div class="col-5">
								<span>Description</span>
							</div>
						</div>

						@foreach (var league in _leagues)
						{
							<div class="row mb-1 align-items-center tourney-card">
								<div class="col-4 border-end border-1 border-light">
									<span>@league.LeagueName</span>
								</div>
								<div class="col-3 border-end border-1 border-light">
									<span>@league.LeagueGame</span>
								</div>
								<div class="col-5">
									<span>@league.LeagueDescription</span>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</div>
</div>

@code {
	private bool _hasLoaded = false;
	private List<TournamentDto> _tournaments;
	private List<TournamentDto>? _upcoming;
	private List<TournamentDto>? _ongoing;
	private List<LeagueDto>? _leagues;

	[Inject]
	private ITournamentService TournamentService { get; set; } = default!;

	[Inject]
	private ILeagueService LeagueService { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		_tournaments = (List<TournamentDto>?)await TournamentService.GetAllAsync();
		_leagues = (List<LeagueDto>?)await LeagueService.GetAllAsync();

		if (_tournaments != null)
		{
			_upcoming = _tournaments.Where(tournament => !tournament.TournamentCancelled && !tournament.TournamentStarted && tournament.TournamentDate.ToDateTime(tournament.TournamentTime) > DateTime.Now.AddMinutes(-15)).ToList();
			_ongoing = _tournaments.Where(tournament => !tournament.TournamentCancelled && tournament.TournamentStarted && !tournament.TournamentFinished).ToList();
		}

		_hasLoaded = true;
	}
}


