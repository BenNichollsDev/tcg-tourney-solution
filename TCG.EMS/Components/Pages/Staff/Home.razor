@page "/home"
@using TCG.Application.Dtos
@using TCG.Application.Services
@using TCG.Application.Interfaces.Services

@inject NavigationManager NavManager

@rendermode InteractiveServer

<div class="container py-4">
	<div class="row">
		<div class="col-12">
			<h1 class="mb-3">TCGTourneys | Dashboard</h1>
		</div>
	</div>

	<div class="row">
		<div class="col-md-6">
			<div class="bg-container p-3 mb-3">
				<h4>Tournaments</h4>

				@if (!_hasLoaded)
				{
					<p>Loading...</p>
				}
				else
				{
					@if (_upcoming != null)
					{
						<h5>Upcoming</h5>
						@foreach (var tournament in _upcoming)
						{
							<NavLink class="text-decoration-none" href="@($"/tournaments/edit/{tournament.TournamentId}")">
								<div class="card mb-2 p-2">
									<div class="d-flex justify-content-between">
										<div>
											<strong>@tournament.TournamentName</strong>
											<div class="text-muted">@tournament.TournamentGame • @tournament.TournamentFormat</div>
										</div>
										<div class="text-end">
											<div>@tournament.TournamentDate</div>
											<div class="text-muted">@tournament.TournamentTime</div>
										</div>
									</div>
								</div>
							</NavLink>
						}
					}

					@if (_ongoing != null)
					{
						<h5 class="mt-3">Ongoing</h5>
						@foreach (var tournament in _ongoing)
						{
							<NavLink class="text-decoration-none" href="@($"/tournaments/view/{tournament.TournamentId}")">
								<div class="card mb-2 p-2">
									<div class="d-flex justify-content-between">
										<div>
											<strong>@tournament.TournamentName</strong>
											<div class="text-muted">@tournament.TournamentGame • @tournament.TournamentFormat</div>
										</div>
										<div class="text-end">
											<div>@tournament.TournamentDate</div>
											<div class="text-muted">@tournament.TournamentTime</div>
										</div>
									</div>
								</div>
							</NavLink>
						}
					}
				}
			</div>
		</div>

		<div class="col-md-6">
			<div class="bg-container p-3 mb-3">
				<h4>Leagues</h4>

				@if (!_hasLoaded)
				{
					<p>Loading...</p>
				}
				else
				{
					@if (_leagues != null)
					{
						@foreach (var league in _leagues)
						{
							<NavLink class="text-decoration-none" href="@($"/leagues/edit/{league.LeagueId}")">
								<div class="card mb-2 p-2">
									<div class="d-flex justify-content-between">
										<div>
											<strong>@league.LeagueName</strong>
											<div class="text-muted">@league.LeagueGame</div>
											<div class="text-muted">@league.LeagueDescription</div>
										</div>
									</div>
								</div>
							</NavLink>
						}
					}
					else
					{
						<p>No leagues</p>
					}
				}
			</div>
		</div>
	</div>
</div>

@code {
	private bool _hasLoaded = false;
	private List<TournamentDto> _tournaments;
	private List<TournamentDto>? _upcoming;
	private List<TournamentDto>? _ongoing;
	private List<LeagueDto>? _leagues;

	[Inject]
	private ITournamentService TournamentService { get; set; } = default!;

	[Inject]
	private ILeagueService LeagueService { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		_tournaments = (List<TournamentDto>?)await TournamentService.GetAllAsync();
		_leagues = (List<LeagueDto>?)await LeagueService.GetAllAsync();

		if (_tournaments != null)
		{
			_upcoming = _tournaments.Where(tournament => !tournament.TournamentCancelled && (!tournament.TournamentStarted || tournament.TournamentDate.ToDateTime(tournament.TournamentTime) <= DateTime.Now.AddMinutes(-15))).ToList();
			_ongoing = _tournaments.Where(tournament => !tournament.TournamentCancelled && tournament.TournamentStarted && !tournament.TournamentFinished).ToList();
		}

		_hasLoaded = true;
	}
}


