@page "/personal"

@using TCG.Application.Dtos
@using TCG.Application.Interfaces.Services

@inject INavigationService NavService
@inject NavigationManager NavManager
@inject StaffSessionService StaffSession

@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-container p-4">
                            
                <h1 class="mb-3 text-center">Account Details</h1>
                    
                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h4 class="">No staff data found.</h4>
                }
                else
                {
                    <EditForm Model="@_staffModel" OnValidSubmit="OnFormSubmit" style="padding-left: 5em; padding-right: 5em; ">
                        <DataAnnotationsValidator/>
                        <ValidationSummary/>

                        <label for="firstname">First Name:</label>
                        <InputText id="firstname"
                                   class="form-control mb-3"
                                   @bind-Value="_staffModel.StaffFirstName"/>

                        <label for="surname">Surname:</label>
                        <InputText id="surname"
                                   class="form-control mb-3"
                                   @bind-Value="_staffModel.StaffSurname"/>

                        <label for="email">Email:</label>
                        <InputText id="email"
                                   class="form-control mb-3"
                                   @bind-Value="_staffModel.StaffEmail"/>

                        <label for="mobile">Mobile:</label>
                        <InputText id="mobile"
                                   class="form-control mb-3"
                                   @bind-Value="_staffModel.StaffMobile"/>

                        <label for="newpassword">New Password:</label>
                        <InputText id="newpassword"
                                   class="form-control mb-3"
                                   type="password"
                                   @bind-Value="_newPassword"/>
                        
                        <br />
                        <br />
                        <br />

                        <label for="password">Current Password:</label>
                        <InputText id="password"
                                   class="form-control mb-3"
                                   type="password"
                                   @bind-Value="_currentPassword"/>

                        <div>
                            <button type="submit" class="btn btn-primary">
                                Submit
                            </button>
                            <NavLink href="/home" type="button" class="btn btn-secondary">
                                Back
                            </NavLink>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private StaffDto? _staffModel = new();
    
    private bool _hasLoaded;
    private bool _showNull;

    private string? _newPassword;
    private string? _currentPassword;
    
    [Parameter]
    [SupplyParameterFromQuery]
    public int? Id { get; set; }

    [Inject]
    private IStaffService StaffService { get; set; } = default!;


    protected override void OnInitialized()
    {
        _newPassword = string.Empty;
        _currentPassword = string.Empty;
        _hasLoaded = false;
        base.OnInitialized();
    }
    
    protected override async Task OnInitializedAsync()
    {
        var userId = StaffSession.StaffId;

        if (userId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _staffModel = await StaffService.GetByIdAsync(userId.Value);

        _hasLoaded = true;
    }
    
    private async Task OnFormSubmit()
    {
       if (!await StaffService.VerifyPasswordAsync(_staffModel.StaffId, _currentPassword ?? string.Empty))
       {
            _showNull = false;

            throw new Exception("Current password is incorrect.");
       }

        if (!string.IsNullOrEmpty(_newPassword))
            _staffModel.StaffPassword = _newPassword;

        await StaffService.UpdateAsync(_staffModel);
        NavService.GoHome();
    }
}

