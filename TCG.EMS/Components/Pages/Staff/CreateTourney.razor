@page "/tournaments/new"

@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using TCG.Application.Interfaces
@using TCG.Application.DTOs
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@using TCG.Application.Dtos
@using TCG.Application.Interfaces.Services
@using TCG.Application.Services
@using TCG.Domain.Entities
@using TCG.EMS.Interfaces

@inject INavigationService NavService
@inject NavigationManager NavManager

@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-8">
            <div class="bg-container p-4">
                
                <h1 class="mb-3 text-center">Create a New Tournament</h1>

                <EditForm Model="@_tournamentModel" OnValidSubmit="OnFormSubmit" style="padding-left: 5em; padding-right: 5em; ">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <label for="name">Name:</label>
                    <InputText id="name"
                               class="form-control mb-3"
                               @bind-Value="_tournamentModel.TournamentName"
                               required />

                    <label for="league">League:</label>
                    <InputSelect id="league"
                                 class="form-control mb-3"
                                 @bind-Value="_tournamentModel.TournamentLeague">

                        <option value="">-- Select League --</option>

                        @foreach (var league in _leagues)
                        {
                            <option value="@league.LeagueId">
                                @league.LeagueName
                            </option>
                        }

                    </InputSelect>

                    <label for="games">Game:</label>
                    <InputSelect id="games"
                                 class="form-control mb-3"
                                 @bind-Value="_tournamentModel.TournamentGame"
                                 @bind:after="OnGameChanged"
                                 required>

                        <option value="">-- Select --</option>
                        <option value="mtg">Magic the Gathering</option>
                        <option value="pkmn">Pokémon</option>
                    </InputSelect>

                    <label for="formats">Format:</label>
                    <InputSelect id="formats"
                                 @key="_tournamentModel.TournamentGame"
                                 class="form-control mb-3"
                                 @bind-Value="_tournamentModel.TournamentFormat"
                                 @bind:after="OnFormatChanged"
                                 required>

                        @if (!string.IsNullOrEmpty(_tournamentModel.TournamentGame))
                        {
                            <option value="">-- Select Format --</option>
                            @foreach (var f in formatsByGame.First(g => g.Key == _tournamentModel.TournamentGame).Value)
                            {
                                <option value="@f.Key">@f.Value["name"]</option>
                            }
                        }
                        else
                        {
                            <option value="">-- Select Game First --</option>
                        }
                    </InputSelect>

                    @if (_tournamentModel.TournamentFormat != "draft" && !string.IsNullOrEmpty(_tournamentModel.TournamentFormat))
                    {
                        <div class="d-flex align-items-center mb-3">
                            <label for="decklist" class="mb-0">Require a Decklist?</label>
                            <InputCheckbox id="decklist"
                                           class="form-check-input ms-2"
                                           @bind-Value="_tournamentModel.TournamentRequireDeck" />
                        </div>
                    }

                    <label for="pairing">Pairing Type:</label>
                    <InputSelect id="pairing"
                                 class="form-control mb-3"
                                 @bind-Value="_tournamentModel.TournamentPairing"
                                 @bind:after="OnPairingChanged"
                                 required>

                        <option value="">-- Select Pairing --</option>
                        <option value="Round-Robin">Round-Robin</option>
                        <option value="Swiss">Swiss</option>

                    </InputSelect>

                    <label for="tourneydate">Date:</label>
                    <input type="date" id="tourneydate" class="form-control mb-3"
                           value='@_tournamentModel.TournamentDate.ToString("yyyy-MM-dd")'
                           min="@MinDateString"
                           @onchange="OnDateInputChanged" />

                    <label for="tourneytime">Time:</label>
                    <input type="time" id="tourneytime" class="form-control mb-3"
                           value='@_tournamentModel.TournamentTime.ToString("HH:mm")'
                           min="@(IsDateToday ? MinTimeString : string.Empty)"
                           @onchange="OnTimeInputChanged" />

                    <label for="playernum">Max Number of Players:</label>
                    <InputNumber id="playernum"
                                 class="form-control mb-3"
                                 @bind-Value="_tournamentModel.TournamentMaxParticipants"
                                 min="2"
                                 required />

                    <label for="playernum">Max Number of Rounds:</label>
                    <InputNumber id="maxroundnum"
                                 class="form-control mb-3"
                                 @key="nameof(_tournamentModel.TournamentMaxRoundNum)"
                                 @bind-Value="_tournamentModel.TournamentMaxRoundNum"
                                 min="1"
                                 required />

                    <label for="price">Entry Fee (£):</label>
                    <InputNumber id="price"
                                 class="form-control mb-3"
                                 step="0.01"
                                 @bind-Value="_tournamentModel.TournamentEntryFee"
                                 @bind:after="OnPriceInputChanged" />

                    <label for="description">Description:</label>
                    <InputTextArea id="description"
                                   class="form-control mb-3"
                                   @bind-Value="_tournamentModel.TournamentDescription"
                                   required />

                    <div>
                        <button type="submit" class="btn btn-primary">
                            Submit
                        </button>
                        <NavLink href="/tournaments" type="button" class="btn btn-secondary">
                            Back
                        </NavLink>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private const string SwissValue = "Swiss";
    private const string RoundRobinValue = "Round-Robin";

    private TournamentDto _tournamentModel = new();

    public int TournamentLeagueId { get; set; }
    public string? TournamentLeague { get; set; }

    [Inject]
    private ITournamentService TournamentService { get; set; } = default!;

    [Inject]
    private ILeagueService LeagueService { get; set; } = default!;

    private List<LeagueDto> _leagues = new();

    private Dictionary<string, Dictionary<string, Dictionary<string, string>>> formatsByGame = new()
    {
        ["mtg"] = new Dictionary<string, Dictionary<string, string>>
        {
            ["Standard"] = new Dictionary<string, string>
            {
                ["name"] = "Constructed - Standard",
                ["pairing"] = SwissValue
            },
            ["Draft"] = new Dictionary<string, string>
            {
                ["name"] = "Limited - Draft",
                ["pairing"] = RoundRobinValue
            }
        },
        ["pkmn"] = new Dictionary<string, Dictionary<string, string>>
        {
            ["Standard"] = new Dictionary<string, string>
            {
                ["name"] = "Standard",
                ["pairing"] = SwissValue
            },
            ["Draft"] = new Dictionary<string, string>
            {
                ["name"] = "Booster Draft",
                ["pairing"] = RoundRobinValue
            }
        }
    };

    protected override void OnInitialized()
    {
        _tournamentModel.TournamentDate = DateOnly.FromDateTime(DateTime.Now);
        _tournamentModel.TournamentTime = TimeOnly.FromDateTime(DateTime.Now);
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        _leagues = (await LeagueService.GetAllAsync()).ToList();
    }

    private bool IsDraft => string.Equals(_tournamentModel.TournamentFormat, "Draft", StringComparison.OrdinalIgnoreCase);

    private void OnGameChanged(ChangeEventArgs e)
    {
        _tournamentModel.TournamentGame = e?.Value as string ?? string.Empty;
        _tournamentModel.TournamentFormat = string.Empty;

        StateHasChanged();
    }

    private void OnPairingChanged(ChangeEventArgs e)
    {
        StateHasChanged();
    }

    private void OnDateInputChanged(ChangeEventArgs e)
    {
        if (e?.Value is string s && DateOnly.TryParse(s, out var d))
        {
            var today = DateOnly.FromDateTime(DateTime.Now);
            _tournamentModel.TournamentDate = d < today ? today : d;

            if (IsDateToday && _tournamentModel.TournamentTime < TimeOnly.FromDateTime(DateTime.Now))
            {
                _tournamentModel.TournamentTime = TimeOnly.FromDateTime(DateTime.Now);
            }
        }

        StateHasChanged();
    }

    private void OnTimeInputChanged(ChangeEventArgs e)
    {
        if (e?.Value is string s && TimeOnly.TryParse(s, out var t))
        {
            if (IsDateToday && t < TimeOnly.FromDateTime(DateTime.Now))
            {
                _tournamentModel.TournamentTime = TimeOnly.FromDateTime(DateTime.Now);
            }
            else
            {
                _tournamentModel.TournamentTime = t;
            }
        }

        StateHasChanged();
    }

    private void OnPriceInputChanged(ChangeEventArgs e)
    {
        if (e?.Value is decimal s)
        {
            _tournamentModel.TournamentEntryFee =
                s < 0 ? 0 : Math.Round(s, 2, MidpointRounding.AwayFromZero);
        }

        StateHasChanged();
    }

    // This runs when the format is changed. It sets the pairing automatically and locks it for Drafts.
    private void OnFormatChanged()
    {
        _tournamentModel.TournamentRequireDeck = false;

        if (!string.IsNullOrEmpty(_tournamentModel.TournamentGame)
            && !string.IsNullOrEmpty(_tournamentModel.TournamentFormat)
            && formatsByGame.TryGetValue(_tournamentModel.TournamentGame, out var formats)
            && formats.TryGetValue(_tournamentModel.TournamentFormat, out var meta))
        {
            if (meta.TryGetValue("pairing", out var pairing))
            {
                _tournamentModel.TournamentPairing = pairing;
            }
        }

        // If the chosen format is the Draft format then make sure pairing is Round-Robin.
        // This prevents choosing another pairing for draft events.
        if (_tournamentModel.TournamentFormat == "Draft")
        {
            _tournamentModel.TournamentPairing = SwissValue == "Round-Robin" ? "Round-Robin" : "Round-Robin";
            _tournamentModel.TournamentPairing = RoundRobinValue;
        }

        StateHasChanged();
    }

    private string MinDateString =>
        DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd");

    private string MinTimeString =>
        DateTime.Now.ToString("HH:mm");

    private bool IsDateToday =>
        _tournamentModel.TournamentDate == DateOnly.FromDateTime(DateTime.Now);

    private bool IsTimeInvalid =>
        IsDateToday && _tournamentModel.TournamentTime < TimeOnly.FromDateTime(DateTime.Now);

    private async Task OnFormSubmit()
    {
        //_tournamentModel.TournamentPairing = formatsByGame[_tournamentModel.TournamentGame][_tournamentModel.TournamentFormat]["pairing"];
        _tournamentModel.TournamentRoundNum = 1;
        _tournamentModel.TournamentStarted = false;
        _tournamentModel.TournamentRoundInProgress = false;
        _tournamentModel.TournamentFinished = false;
        _tournamentModel.TournamentCancelled = false;

        // Generate a random seed for the tournament for head-to-head resolutions
        _tournamentModel.TournamentSeed = new Random().Next(1, int.MaxValue);


        await TournamentService.CreateAsync(_tournamentModel);
        NavService.GoTourney();
    }
}

