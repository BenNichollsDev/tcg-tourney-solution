@page "/tournaments/view/{tournamentId:int}"
@using TCG.Application.Dtos

@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="bg-container p-4">

                @if (_notice != null)
                {
                    <div class="alert alert-warning">
                        @_notice
                    </div>
                }

                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h1 class="mb-3 text-center">@_tournamentModel.TournamentName</h1>

                    <p>Start date: @_tournamentModel.TournamentDate</p>
                    <p>Start time: @_tournamentModel.TournamentTime</p>

                    <h5>Round @_tournamentModel.TournamentRoundNum</h5>

                    <h4>Participants</h4>

                    <!-- (PAIRING UI unchanged for brevity) -->

                }
            </div>

            <!-- ========================= -->
            <!-- STANDINGS SECTION -->
            <!-- ========================= -->
            <div class="bg-container p-4 mt-3">

                @if (_tournamentModel.TournamentPairing == "Round-Robin")
                {
                    <h4>Round Robin Standings</h4>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Wins</th>
                                <th>Score</th>
                                <th>Match Points</th>
                                <th>Points</th>
                                <th>OMW%</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var p in _participants
                                .OrderByDescending(x => x.PlayerRoundRobinScore ?? 0))
                            {
                                <tr>
                                    <td>@p.PlayerName</td>
                                    <td>@(p.PlayerRoundRobinWins ?? 0)</td>
                                    <td>@(p.PlayerRoundRobinScore ?? 0)</td>
                                    <td>@((float)(p.PlayerRoundRobinMatchPoints ?? 0f))</td>
                                    <td>@((float)(p.PlayerRoundRobinPoints ?? 0f))</td>
                                    <td>@CalculateOMWPercent(p.TournamentPlayerId).ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <h4>Swiss Standings</h4>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Score</th>
                                <th>Wins</th>
                                <th>Match Points</th>
                                <th>Points</th>
                                <th>OMW%</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var p in _participants
                                .OrderByDescending(x => x.PlayerSwissScore ?? 0)
                                .ThenByDescending(x => CalculateOMWPercent(x.TournamentPlayerId)))
                            {
                                <tr>
                                    <td>@p.PlayerName</td>
                                    <td>@(p.PlayerSwissScore ?? 0)</td>
                                    <td>@(p.PlayerSwissWins ?? 0)</td>
                                    <td>@((float)(p.PlayerSwissMatchPoints ?? 0f))</td>
                                    <td>@((float)(p.PlayerSwissPoints ?? 0f))</td>
                                    <td>@CalculateOMWPercent(p.TournamentPlayerId).ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </div>

        </div>
    </div>
</div>

@code {
    private const string BYE = "bye";

    private bool _hasLoaded;
    private bool _showNull;
    private string? _notice;

    private class PairingSelection
    {
        public string? Player1Id { get; set; }
        public string? Player2Id { get; set; }
    }

    [Parameter] public int? TournamentId { get; set; }

    private TournamentDto _tournamentModel = new();

    [Inject] private ITournamentService TournamentService { get; set; } = null!;
    [Inject] private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;
    [Inject] private IPairingService PairingService { get; set; } = null!;

    private List<TournamentPlayerDto> _participants = new();
    private List<PairingSelection> _pairings = new();

    private HashSet<string> _pastPairings = new();
    private HashSet<int> _playersWithBye = new();
    private Dictionary<int, double> _omwCache = new();
    private List<PairingDto> _allPairingsForTournament = new();

    private int _possibleNumOfPairings;
    private bool _isOddNumOfParticipants;

    protected override async Task OnInitializedAsync()
    {
        if (TournamentId is null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);

        _participants = (await TournamentPlayerService
            .GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value))
            .ToList();

        _isOddNumOfParticipants = _participants.Count % 2 != 0;
        _possibleNumOfPairings = (_participants.Count + 1) / 2;

        _pairings = Enumerable.Range(0, _possibleNumOfPairings)
            .Select(_ => new PairingSelection())
            .ToList();

        _hasLoaded = true;
    }

    private void NavigateToInProgress()
        => NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");

    private string MakePairKey(int a, int b)
        => a < b ? $"{a}-{b}" : $"{b}-{a}";

    private bool WouldCreateDuplicatePairings()
    {
        var available = _participants.ToList();
        var used = new HashSet<int>();

        foreach (var p in available)
        {
            if (used.Contains(p.TournamentPlayerId))
                continue;

            bool found = false;

            foreach (var o in available)
            {
                if (o.TournamentPlayerId == p.TournamentPlayerId)
                    continue;

                if (used.Contains(o.TournamentPlayerId))
                    continue;

                var key = MakePairKey(p.TournamentPlayerId, o.TournamentPlayerId);

                if (_pastPairings.Contains(key))
                    continue;

                found = true;
                used.Add(p.TournamentPlayerId);
                used.Add(o.TournamentPlayerId);
                break;
            }

            if (!found)
            {
                if (_playersWithBye.Contains(p.TournamentPlayerId))
                    continue;

                used.Add(p.TournamentPlayerId);
            }
        }
        
        return used.Count < _participants.Count;
    }

    private async Task StartRRMatchRandomAsync()
    {
        if (WouldCreateDuplicatePairings())
        {
            _notice = "Cannot generate Round Robin pairings without creating duplicate matches.";
            return;
        }

        var shuffled = _participants
            .OrderBy(_ => Guid.NewGuid())
            .ToList();

        var used = new HashSet<int>();
        var pairings = new List<PairingSelection>();

        for (int i = 0; i < shuffled.Count; i++)
        {
            var current = shuffled[i];

            if (used.Contains(current.TournamentPlayerId))
                continue;

            TournamentPlayerDto? opponent = null;

            for (int j = i + 1; j < shuffled.Count; j++)
            {
                var candidate = shuffled[j];

                if (used.Contains(candidate.TournamentPlayerId))
                    continue;

                var key = MakePairKey(current.TournamentPlayerId, candidate.TournamentPlayerId);

                if (_pastPairings.Contains(key))
                    continue;

                opponent = candidate;
                _pastPairings.Add(key);

                used.Add(current.TournamentPlayerId);
                used.Add(candidate.TournamentPlayerId);

                break;
            }

            if (opponent != null)
            {
                pairings.Add(new PairingSelection
                {
                    Player1Id = current.TournamentPlayerId.ToString(),
                    Player2Id = opponent.TournamentPlayerId.ToString()
                });

                continue;
            }

            if (!_playersWithBye.Contains(current.TournamentPlayerId))
            {
                _playersWithBye.Add(current.TournamentPlayerId);

                pairings.Add(new PairingSelection
                {
                    Player1Id = current.TournamentPlayerId.ToString(),
                    Player2Id = BYE
                });

                used.Add(current.TournamentPlayerId);
            }
        }

        _pairings = pairings;

        await SavePairingsAsync();
        NavigateToInProgress();
    }

    private void GenerateSwissPairings()
    {
        if (WouldCreateDuplicatePairings())
        {
            _notice = "Cannot generate Swiss pairings without creating duplicate matches.";
            return;
        }

        var sorted = _participants
            .OrderByDescending(p => p.PlayerSwissPoints ?? 0)
            .ThenBy(p => p.TournamentPlayerId)
            .ToList();

        _pairings.Clear();

        var used = new HashSet<int>();

        for (int i = 0; i < sorted.Count; i++)
        {
            var current = sorted[i];

            if (used.Contains(current.TournamentPlayerId))
                continue;

            TournamentPlayerDto? opponent = null;

            for (int j = i + 1; j < sorted.Count; j++)
            {
                var candidate = sorted[j];

                if (used.Contains(candidate.TournamentPlayerId))
                    continue;

                var key = MakePairKey(current.TournamentPlayerId, candidate.TournamentPlayerId);

                if (_pastPairings.Contains(key))
                    continue;

                opponent = candidate;
                _pastPairings.Add(key);

                used.Add(current.TournamentPlayerId);
                used.Add(candidate.TournamentPlayerId);

                break;
            }

            if (opponent != null)
            {
                _pairings.Add(new PairingSelection
                {
                    Player1Id = current.TournamentPlayerId.ToString(),
                    Player2Id = opponent.TournamentPlayerId.ToString()
                });

                continue;
            }

            if (!_playersWithBye.Contains(current.TournamentPlayerId))
            {
                _playersWithBye.Add(current.TournamentPlayerId);

                _pairings.Add(new PairingSelection
                {
                    Player1Id = current.TournamentPlayerId.ToString(),
                    Player2Id = BYE
                });

                used.Add(current.TournamentPlayerId);
            }
        }
    }

    private async Task StartTournamentAsync()
    {
        await SavePairingsAsync();
        CheckRoundLimit();
        NavigateToInProgress();
    }

    private void CheckRoundLimit()
    {
        if (_tournamentModel.TournamentMaxRoundNum.HasValue &&
            _tournamentModel.TournamentRoundNum >= _tournamentModel.TournamentMaxRoundNum)
        {
            _notice = "The maximum number of rounds has been reached.";
        }
    }

    private async Task SavePairingsAsync()
    {
        foreach (var p in _pairings)
        {
            if (p.Player1Id == BYE) p.Player1Id = null;
            if (p.Player2Id == BYE) p.Player2Id = null;

            await PairingService.CreateAsync(new PairingDto
            {
                PairingTp1 = p.Player1Id is null ? null : int.Parse(p.Player1Id),
                PairingTp2 = p.Player2Id is null ? null : int.Parse(p.Player2Id)
            });
        }
    }

    private async Task EndTournament()
        => await Task.CompletedTask;

    private async Task BeginTopCut()
        => await Task.CompletedTask;

    private bool CanStartMatch()
        => _pairings.SelectMany(p => new[] { p.Player1Id, p.Player2Id })
                    .Count(x => x != null) == _participants.Count;

    private Task OnPlayer1Changed(PairingSelection p, string? id)
    {
        RemoveDuplicatePlayer(p, id);
        return InvokeAsync(StateHasChanged);
    }

    private Task OnPlayer2Changed(PairingSelection p, string? id)
    {
        RemoveDuplicatePlayer(p, id);
        return InvokeAsync(StateHasChanged);
    }

    private void RemoveDuplicatePlayer(PairingSelection selected, string? playerId)
    {
        int i = 0;

        foreach (var pairing in _pairings)
        {
            if (Equals(pairing, selected)) { i++; continue; }

            if (pairing.Player1Id == playerId)
                _pairings[i].Player1Id = null;

            if (pairing.Player2Id == playerId)
                _pairings[i].Player2Id = null;

            i++;
        }
    }
    
    private double CalculateOMWPercent(int playerId)
    {
        if (_omwCache.TryGetValue(playerId, out var cached))
            return cached;

        var playerPairings = _allPairingsForTournament
            .Where(p => p.PairingTp1 == playerId || p.PairingTp2 == playerId)
            .ToList();

        if (!playerPairings.Any())
            return 0.33; // default baseline

        var opponentWinRates = new List<double>();

        foreach (var pairing in playerPairings)
        {
            int? opponentId =
                pairing.PairingTp1 == playerId
                    ? pairing.PairingTp2
                    : pairing.PairingTp1;

            if (opponentId == null)
                continue;

            var opponentMatches = _allPairingsForTournament
                .Where(p => p.PairingTp1 == opponentId || p.PairingTp2 == opponentId)
                .ToList();

            if (!opponentMatches.Any())
            {
                opponentWinRates.Add(0.33);
                continue;
            }

            int wins = opponentMatches.Count(p => p.WinnerId == opponentId);
            int total = opponentMatches.Count;

            opponentWinRates.Add((double)wins / total);
        }

        var result = opponentWinRates.Any()
            ? opponentWinRates.Average()
            : 0.33;

        _omwCache[playerId] = result;
        return result;
    }
}