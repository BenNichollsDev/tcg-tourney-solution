@page "/tournaments/view/{tournamentId:int}"
@using TCG.Application.Dtos
@using TCG.Domain.Entities

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-container p-4">

                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h1 class="mb-3 text-center">@_tournamentModel.TournamentName</h1>

                    <p>Start date: @_tournamentModel.TournamentDate</p>
                    <p>Start time: @_tournamentModel.TournamentTime</p>

                    <h5>Round @_tournamentModel.TournamentRoundNum</h5>

                    <h4>Participants</h4>

                    @if (_tournamentModel.TournamentPairing == "Round-Robin")
                    {
                        <button class="btn btn-primary"
                                disabled="@(!CanStartMatch())"
                                @onclick="StartTournamentAsync">
                            Start Match
                        </button>

                        <button class="btn btn-primary ms-2"
                                @onclick="StartRRMatchRandomAsync">
                            Auto-Assign Pairings and Start Match
                        </button>

                        <EditForm Model="_pairings">

                            @foreach (var pairing in _pairings)
                            {
                                <div class="mb-3 border p-2">
                                    <div class="row">

                                        <div class="col">
                                            <InputSelect TValue="int?"
                                                         class="form-control"
                                                         Value="@pairing.Player1Id"
                                                         ValueChanged="@(v => AssignPlayer(pairing, true, v))"
                                                         ValueExpression="@(() => pairing.Player1Id)">

                                                <option value="">-- Select Player 1 --</option>

                                                @foreach (var p in GetAvailablePlayers(pairing, pairing.Player1Id))
                                                {
                                                    <option value="@p.TournamentPlayerId">
                                                        @p.PlayerName
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col">
                                            <InputSelect TValue="int?"
                                                         class="form-control"
                                                         Value="@pairing.Player2Id"
                                                         ValueChanged="@(v => AssignPlayer(pairing, false, v))"
                                                         ValueExpression="@(() => pairing.Player2Id)">

                                                <option value="">-- Select Player 2 --</option>

                                                @foreach (var p in GetAvailablePlayers(pairing, pairing.Player2Id))
                                                {
                                                    <option value="@p.TournamentPlayerId">
                                                        @p.PlayerName
                                                    </option>
                                                }

                                                @if (_isOddNumOfParticipants)
                                                {
                                                    <option value="">Bye</option>
                                                }
                                            </InputSelect>
                                        </div>

                                    </div>
                                </div>
                            }

                        </EditForm>
                    }
                    else
                    {
                        <div class="mb-3">
                            <button class="btn btn-outline-primary me-2"
                                    @onclick="GenerateSwissPairings">
                                Generate Swiss Pairings
                            </button>

                            <button class="btn btn-primary"
                                    @onclick="StartTournamentAsync"
                                    disabled="@(!_pairings.Any())">
                                Start Swiss Round
                            </button>
                        </div>

                        <EditForm Model="_pairings">

                            @foreach (var pairing in _pairings)
                            {
                                <div class="mb-3 border p-2">
                                    <div class="row">

                                        <div class="col">
                                            <InputSelect TValue="int?"
                                                         class="form-control"
                                                         Value="@pairing.Player1Id"
                                                         ValueChanged="@(v => AssignPlayer(pairing, true, v))"
                                                         ValueExpression="@(() => pairing.Player1Id)">

                                                <option value="">-- Select Player 1 --</option>

                                                @foreach (var p in GetAvailablePlayers(pairing, pairing.Player1Id))
                                                {
                                                    <option value="@p.TournamentPlayerId">
                                                        @p.PlayerName
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col">
                                            <InputSelect TValue="int?"
                                                         class="form-control"
                                                         Value="@pairing.Player2Id"
                                                         ValueChanged="@(v => AssignPlayer(pairing, false, v))"
                                                         ValueExpression="@(() => pairing.Player2Id)">

                                                <option value="">-- Select Player 2 --</option>

                                                @foreach (var p in GetAvailablePlayers(pairing, pairing.Player2Id))
                                                {
                                                    <option value="@p.TournamentPlayerId">
                                                        @p.PlayerName
                                                    </option>
                                                }

                                                @if (_isOddNumOfParticipants)
                                                {
                                                    <option value="">Bye</option>
                                                }
                                            </InputSelect>
                                        </div>

                                    </div>
                                </div>
                            }

                        </EditForm>
                    }

                    <button type="button" class="btn btn-secondary mt-2">
                        Back
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool _hasLoaded;
    private bool _showNull;
    private bool _matchStarted;

    private class PairingSelection
    {
        public int? Player1Id { get; set; }
        public int? Player2Id { get; set; }
    }

    [Parameter] public int? TournamentId { get; set; }

    private TournamentDto? _tournamentModel = new();

    [Inject] private ITournamentService TournamentService { get; set; } = null!;
    [Inject] private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;
    [Inject] private IPairingService PairingService { get; set; } = null!;

    private List<TournamentPlayerDto> _participants = new();
    private List<PairingSelection> _pairings = new();

    private int _possibleNumOfPairings;
    private bool _isOddNumOfParticipants;

    protected override async Task OnInitializedAsync()
    {
        if (TournamentId is null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);

        _participants = (await TournamentPlayerService
            .GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value))
            .ToList();

        _isOddNumOfParticipants = _participants.Count % 2 != 0;
        _possibleNumOfPairings = (_participants.Count + 1) / 2;

        _pairings = Enumerable.Range(0, _possibleNumOfPairings)
            .Select(_ => new PairingSelection())
            .ToList();

        _hasLoaded = true;
    }
    
    private void AssignPlayer(PairingSelection current, bool isP1, int? selected)
    {
        if (selected is not null)
        {
            foreach (var p in _pairings)
            {
                if (ReferenceEquals(p, current))
                    continue;

                if (p.Player1Id == selected) p.Player1Id = null;
                if (p.Player2Id == selected) p.Player2Id = null;
            }
        }

        if (isP1)
            current.Player1Id = selected;
        else
            current.Player2Id = selected;

        InvokeAsync(StateHasChanged);
    }
    
    private IEnumerable<TournamentPlayerDto> GetAvailablePlayers(PairingSelection current, int? currentValue)
    {
        var used = _pairings
            .SelectMany(p => new[] { p.Player1Id, p.Player2Id })
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .ToHashSet();

        return _participants.Where(p =>
            !used.Contains(p.TournamentPlayerId)
            || p.TournamentPlayerId == currentValue);
    }
    
    private async Task StartRRMatchRandomAsync()
    {
        var shuffled = _participants
            .OrderBy(_ => Guid.NewGuid())
            .ToList();

        _pairings = BuildPairings(shuffled);

        await StartTournamentAsync();
    }
    
    private void GenerateSwissPairings()
    {
        var sorted = _participants
            .OrderByDescending(p => p.PlayerSwissPoints ?? 0)
            .ThenBy(p => p.TournamentPlayerId)
            .ToList();

        _pairings = BuildPairings(sorted);
    }
    
    private static List<PairingSelection> BuildPairings(List<TournamentPlayerDto> players)
    {
        var result = new List<PairingSelection>();

        for (int i = 0; i < players.Count; i += 2)
        {
            result.Add(new PairingSelection
            {
                Player1Id = players[i].TournamentPlayerId,
                Player2Id = i + 1 < players.Count
                    ? players[i + 1].TournamentPlayerId
                    : null
            });
        }

        return result;
    }
    
    private async Task StartTournamentAsync()
    {
        await SavePairingsAsync();
        NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
    }

    private async Task SavePairingsAsync()
    {
        foreach (var p in _pairings)
        {
            await PairingService.CreateAsync(new PairingDto
            {
                PairingTp1 = p.Player1Id,
                PairingTp2 = p.Player2Id
            });
        }
    }

    private bool CanStartMatch()
    {
        var assigned = _pairings
            .SelectMany(p => new[] { p.Player1Id, p.Player2Id })
            .Count(x => x.HasValue);

        return assigned == _participants.Count;
    }
}