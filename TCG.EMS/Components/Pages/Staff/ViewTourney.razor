@page "/tournaments/view/{tournamentId:int}"
@using TCG.Application.Dtos
@using TCG.Domain.Entities

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-container p-4">

                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h1 class="mb-3 text-center">@_tournamentModel.TournamentName</h1>
                    <p>Start date: @_tournamentModel.TournamentDate</p>
                    <p>Start time: @_tournamentModel.TournamentTime</p>

                    <h3>Participants</h3>
                    
                    @if (_tournamentModel.TournamentFormat == "Round-Robin")
                    {
                        <EditForm Model="_pairings">

                            @foreach (var pairing in _pairings)
                            {
                                <div class="mb-3 border p-2">
                                    <div class="row">

                                        <div class="col">
                                            <InputSelect class="form-control"
                                                         @bind-Value="pairing.Player1Id">
                                                <option value="">-- Select Player 1 --</option>

                                                @foreach (var participant in GetAvailablePlayers())
                                                {
                                                    <option value="@participant.TournamentPlayerId">
                                                        @participant.PlayerName
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col">
                                            <InputSelect class="form-control"
                                                         @bind-Value="pairing.Player2Id">
                                                <option value="">-- Select Player 2 --</option>

                                                @foreach (var participant in GetAvailablePlayers())
                                                {
                                                    <option value="@participant.TournamentPlayerId">
                                                        @participant.PlayerName
                                                    </option>
                                                }

                                                @if (_isOddNumOfParticipants && GetAvailablePlayers().Count == 1)
                                                {
                                                    <option value="">Bye</option>
                                                }
                                            </InputSelect>
                                        </div>

                                    </div>
                                </div>
                            }

                        </EditForm>

                        <NavLink class="btn btn-primary" disabled="@(!CanStartMatch())" @onclick="StartRRMatchAsync">
                            Start Match
                        </NavLink>

                        <NavLink class="btn btn-primary" @onclick="StartRRMatchRandomAsync">
                            Auto-Assign Pairings and Start Match
                        </NavLink>

                        <button type="button" class="btn btn-secondary ms-2">
                            Back
                        </button>
                    }
                    else
                    {
                        <h3>Swiss Pairings</h3>

                        <div class="mb-3">
                            <button class="btn btn-outline-primary me-2" @onclick="GenerateSwissPairings">Generate Swiss Pairings</button>
                            <button class="btn btn-primary" @onclick="StartSwissMatchAsync" disabled="@(!_pairings.Any())">Start Swiss Round</button>
                        </div>

                        @if (_pairings.Any())
                        {
                            @foreach (var pairing in _pairings)
                            {
                                <div class="mb-2 border p-2">
                                    <div class="row">
                                        <div class="col">@GetPlayerName(pairing.Player1Id)</div>
                                        <div class="col text-center">vs</div>
                                        <div class="col">@GetPlayerName(pairing.Player2Id)@(pairing.Player2Id == null ? " (BYE)" : "")</div>
                                    </div>
                                </div>
                            }
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool _hasLoaded;
    private bool _showNull;
    private bool _matchStarted;

    [Parameter]
    public int? TournamentId { get; set; }

    private TournamentDto? _tournamentModel = new();

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;

    [Inject]
    private IPairingService PairingService { get; set; } = null!;

    private List<TournamentPlayerDto> _participants = new();

    private List<PairingSelection> _pairings = new();

    private int _possibleNumOfPairings;
    private bool _isOddNumOfParticipants = false;

    protected override async Task OnInitializedAsync()
    {
        _hasLoaded = false;
        _showNull = false;
        _matchStarted = false;

        if (TournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);

        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        var allPlayers = await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value);

        _participants = allPlayers
            .Where(p => p.TournamentId == TournamentId.Value)
            .ToList();

        _isOddNumOfParticipants = _participants.Count % 2 != 0;

        _possibleNumOfPairings = _participants.Count / 2;

        _pairings = new List<PairingSelection>();

        for (int i = 0; i < _possibleNumOfPairings; i++)
        {
            _pairings.Add(new PairingSelection());
        }

        _hasLoaded = true;
    }

    private List<TournamentPlayerDto> GetAvailablePlayers()
    {
        var selectedIds = new List<int>();

        foreach (var pairing in _pairings)
        {
            if (pairing.Player1Id.HasValue)
                selectedIds.Add(pairing.Player1Id.Value);

            if (pairing.Player2Id.HasValue)
                selectedIds.Add(pairing.Player2Id.Value);
        }

        return _participants
            .Where(p => !selectedIds.Contains(p.TournamentPlayerId))
            .ToList();
    }

    private bool CanStartMatch()
    {
        return (
            _pairings.All(p =>
                p is { Player1Id: not null, Player2Id: not null }) &&
            GetAvailablePlayers().Count == 0 &&
            !_matchStarted);
    }

    private async Task StartRRMatchAsync()
    {
        _matchStarted = true;

        foreach (var pairing in _pairings)
        {
            await PairingService.CreateAsync(
                new PairingDto()
                {
                    PairingTp1 = pairing.Player1Id,
                    PairingTp2 = pairing.Player2Id
                });
        }

        _tournamentModel.TournamentRoundNum = 1;

        NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
    }
    
    private async Task StartRRMatchRandomAsync()
    {
        if (_matchStarted)
            return;

        _matchStarted = true;
        
        var random = new Random();

        var shuffled = _participants
            .OrderBy(_ => random.Next())
            .ToList();

        _pairings = new List<PairingSelection>();

        for (int i = 0; i < shuffled.Count; i += 2)
        {
            var pairing = new PairingSelection
            {
                Player1Id = shuffled[i].TournamentPlayerId,
                Player2Id = (i + 1 < shuffled.Count)
                    ? shuffled[i + 1].TournamentPlayerId
                    : null
            };

            _pairings.Add(pairing);
        }
        
        foreach (var pairing in _pairings)
        {
            await PairingService.CreateAsync(
                new PairingDto
                {
                    PairingTp1 = pairing.Player1Id,
                    PairingTp2 = pairing.Player2Id
                });
        }

        _tournamentModel.TournamentRoundNum = 1;
        
        NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
    }

    private class PairingSelection
    {
        public int? Player1Id { get; set; }
        public int? Player2Id { get; set; }
    }

    // Swiss helpers
    private string GetPlayerName(int? tpId)
    {
        if (tpId == null) return "BYE";
        var p = _participants.FirstOrDefault(x => x.TournamentPlayerId == tpId.Value);
        return p?.PlayerName ?? "Unknown";
    }

    private int GetPlayerScore(TournamentPlayerDto p)
    {
        // Try common score properties; update to use actual DTO field if present
        var scoreTypes = new[] { "PlayerSwissWins", "PlayerSwissScore", "PlayerSwissMatchPoints", "PlayerSwissPoints" };
        foreach (var name in scoreTypes)
        {
            var reflection = p.GetType().GetProperty(name);
            if (reflection == null) continue;
            var val = reflection.GetValue(p);
            if (val is int iv) return iv;
            if (val is long lv) return (int)lv;
            if (val is double dv) return (int)dv;
            if (val is decimal dc) return (int)dc;
        }
        return 0;
    }

    private void GenerateSwissPairings()
    {
        var sorted = _participants
            .OrderByDescending(p => GetPlayerScore(p))
            .ThenBy(p => p.TournamentPlayerId)
            .ToList();

        _pairings = new List<PairingSelection>();

        for (int i = 0; i < sorted.Count; i += 2)
        {
            var p1 = sorted[i];
            int? p2id = (i + 1 < sorted.Count) ? sorted[i + 1].TournamentPlayerId : (int?)null;

            _pairings.Add(new PairingSelection
            {
                Player1Id = p1.TournamentPlayerId,
                Player2Id = p2id
            });
        }
    }

    private async Task StartSwissMatchAsync()
    {
        if (!_pairings.Any()) return;

        foreach (var pairing in _pairings)
        {
            await PairingService.CreateAsync(new PairingDto
            {
                PairingTp1 = pairing.Player1Id,
                PairingTp2 = pairing.Player2Id
            });

            // If pairing.Player2Id == null then this is a BYE. Award points if needed here.
            // TEST THE WGHOLE SYSTEM ASAP SO FAR AND MAKE FIXES AS NECCESARY
        }

        _tournamentModel.TournamentRoundNum = 1;
        NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
    }
}