@page "/tournaments/view/{tournamentId:int}"
@using TCG.Application.Dtos
@using TCG.Application.Services

@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-container p-4">

                @if (_notice != null)
                {
                    <div class="alert alert-warning">
                        @_notice
                    </div>
                }

                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h1 class="mb-3 text-center">@_tournamentModel?.TournamentName</h1>

                    <p>Start date: @_tournamentModel?.TournamentDate</p>
                    <p>Start time: @_tournamentModel?.TournamentTime</p>

                    <p>Round @_tournamentModel?.TournamentRoundNum</p>

                    <hr />

                    @if (_tournamentModel?.TournamentPairing == "Round-Robin")
                    {
                        <h2 class="mt-4">Pairings</h2>

                        @foreach (var pairing in _pairings)
                        {
                            <div class="d-flex gap-2 mb-2" @key="pairing">

                                <select class="form-select"
                                        value="@(pairing.Player1Id ?? "")"
                                        @onchange="args => OnPlayer1Changed(pairing, args)">

                                    <option value="">-- Player 1 --</option>

                                    @foreach (var p in GetPlayerLists().unassigned)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    @foreach (var p in GetPlayerLists().assigned)
                                    {
                                        <option value="@p.TournamentPlayerId" style="color: gray;">@p.PlayerName</option>
                                    }

                                    <option value="@BYE">BYE</option>
                                </select>

                                <span class="align-self-center">VS</span>

                                <select class="form-select"
                                        value="@(pairing.Player2Id ?? "")"
                                        @onchange="args => OnPlayer2Changed(pairing, args)">

                                    <option value="">-- Player 2 --</option>

                                    @foreach (var p in GetPlayerLists().unassigned)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    @foreach (var p in GetPlayerLists().assigned)
                                    {
                                        <option value="@p.TournamentPlayerId" style="color: gray;">@p.PlayerName</option>
                                    }

                                    <option value="@BYE">BYE</option>
                                </select>

                            </div>
                        }

                        <hr />

                        <h2>Round Robin Standings</h2>

                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>Player</th>
                                <th>Wins</th>
                                <th>Draws</th>
                                <th>Losses</th>
                                <th>Points</th>
                                <th>OMW%</th>
                            </tr>
                            </thead>

                            <tbody>
                            @foreach (var s in _computedStats)
                            {
                                var player = _participants.FirstOrDefault(x => x.TournamentPlayerId == s.TournamentPlayerId);
                                <tr>
                                    <td>@(player?.PlayerName ?? "Unknown")</td>
                                    <td>@s.Wins</td>
                                    <td>@s.Draws</td>
                                    <td>@s.Losses</td>
                                    <td>@s.Points</td>
                                    <td>@s.OmwPercent.ToString("0.00")</td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-primary"
                                    @onclick="GenerateRoundRobinPairings"
                                    disabled="@(!HasMinimumPlayers)">
                                Generate Pairings and Start Round
                            </button>

                            <button class="btn btn-primary"
                                    @onclick="StartRoundAsync"
                                    disabled="@(!CanStartMatch() && !HasMinimumPlayers)">
                                Start Round
                            </button>
                        </div>
                    }
                    else
                    {
                        <h5 class="mt-3">Pairings</h5>

                        @foreach (var pairing in _pairings)
                        {
                            <div class="d-flex gap-2 mb-2" @key="pairing">

                                <select class="form-select"
                                        value="@(pairing.Player1Id ?? "")"
                                        @onchange="args => OnPlayer1Changed(pairing, args)">

                                    <option value="">-- Player 1 --</option>

                                    @foreach (var p in GetPlayerLists().unassigned)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    @foreach (var p in GetPlayerLists().assigned)
                                    {
                                        <option value="@p.TournamentPlayerId" style="color: gray;">@p.PlayerName</option>
                                    }

                                    <option value="@BYE">BYE</option>
                                </select>

                                <span class="align-self-center">VS</span>

                                <select class="form-select"
                                        value="@(pairing.Player2Id ?? "")"
                                        @onchange="args => OnPlayer2Changed(pairing, args)">

                                    <option value="">-- Player 2 --</option>

                                    @foreach (var p in GetPlayerLists().unassigned)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    @foreach (var p in GetPlayerLists().assigned)
                                    {
                                        <option value="@p.TournamentPlayerId" style="color: gray;">@p.PlayerName</option>
                                    }

                                    <option value="@BYE">BYE</option>
                                </select>

                            </div>
                        }

                        <div class="mt-3 d-flex gap-2">

                            <button class="btn btn-secondary"
                                    @onclick="GenerateSwissPairings"
                                    disabled="@(!HasMinimumPlayers)">
                                Generate Pairings and Start Round
                            </button>

                            <button class="btn btn-primary"
                                    @onclick="StartRoundAsync"
                                    disabled="@(!CanStartMatch() && !HasMinimumPlayers)">
                                Start Round
                            </button>

                        </div>

                        <hr />

                        <h2 class="mt-4">Swiss Standings</h2>

                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>Player</th>
                                <th>Points</th>
                                <th>Wins</th>
                                <th>Draws</th>
                                <th>Losses</th>
                                <th>Game Win %</th>
                                <th>OMW%</th>
                            </tr>
                            </thead>

                            <tbody>
                            @foreach (var s in _computedStats)
                            {
                                var player = _participants.FirstOrDefault(x => x.TournamentPlayerId == s.TournamentPlayerId);
                                <tr>
                                    <td>@(player?.PlayerName ?? "Unknown")</td>
                                    <td>@s.Points</td>
                                    <td>@s.Wins</td>
                                    <td>@s.Draws</td>
                                    <td>@s.Losses</td>
                                    <td>@s.GameWinPercent.ToString("0.00")</td>
                                    <td>@s.OmwPercent.ToString("0.00")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                }

                <div class="mt-3">
                    <NavLink class="btn btn-outline-dark" href="/tournaments">
                        Back
                    </NavLink>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    private const string BYE = "bye";

    private bool _hasLoaded;
    private bool _showNull;
    private string? _notice;
    private bool _pairingsAreValid = false;
    private int _roundNum;

    private bool HasMinimumPlayers => _participants.Count >= 2;

    private TournamentDto? _tournamentModel = new();

    private class PairingSelection
    {
        public string? Player1Id { get; set; }
        public string? Player2Id { get; set; }
    }

    private List<PairingSelection> _pairings = new();
    private List<TournamentPlayerDto> _participants = new();
    private List<TournamentScoringService.PlayerComputedStats> _computedStats = new();

    [Parameter]
    public int? TournamentId { get; set; }

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;

    [Inject]
    private IPairingService PairingService { get; set; } = null!;

    [Inject]
    private TournamentScoringService ScoringService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _hasLoaded = false;
        _showNull = false;

        if (TournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);
        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        // If tournament is in progress, redirect to in-progress page
        if (_tournamentModel.TournamentInProgress)
        {
            NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
            return;
        }

        _participants = (await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value)).ToList();

        // Check if there are at least two participants
        _participants = (await TournamentPlayerService
            .GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value))
            .ToList();

        if (!HasMinimumPlayers)
        {
            _notice = "You must add at least two players to be able to start this tournament.";
        }

        // initialise pairings based on participants count
        _pairings = new List<PairingSelection>();
        int pairCount = _participants.Count / 2;
        for (int i = 0; i < pairCount; i++) _pairings.Add(new PairingSelection());

        _computedStats = await ScoringService.ComputeAllAsync(TournamentId.Value);

        _hasLoaded = true;

        _roundNum = _tournamentModel.TournamentRoundNum == null ? 0 : _tournamentModel.TournamentRoundNum.Value;
    }

    // Normalise pairings so Player1 is always the actual player and Player2 is BYE if applicable
    private List<PairingDto> NormalizePairingsForPersist()
    {
        var result = new List<PairingDto>();
        foreach (var p in _pairings)
        {
            string? p1 = p.Player1Id;
            string? p2 = p.Player2Id;

            // Interpret BYE strings as null
            if (string.Equals(p1, BYE, StringComparison.OrdinalIgnoreCase)) p1 = null;
            if (string.Equals(p2, BYE, StringComparison.OrdinalIgnoreCase)) p2 = null;

            // Skip pairings with two BYEs
            if (p1 == null && p2 == null)
            {
                continue;
            }

            // If only one side has a player, ensure player is set to Player1 and Player2 is null (BYE)
            if (p1 == null && p2 != null)
            {
                // swap
                var temp = p1;
                p1 = p2;
                p2 = temp;
            }

            int? tp1 = null;
            int? tp2 = null;

            if (int.TryParse(p1, out var id1)) tp1 = id1;
            if (int.TryParse(p2, out var id2)) tp2 = id2;

            result.Add(new PairingDto
            {
                PairingTournamentId = TournamentId.Value,
                PairingTp1 = tp1,
                PairingTp2 = tp2
            });
        }

        return result;
    }

    private async Task NormalizeAndSavePairingsAsync()
    {
        var normalized = NormalizePairingsForPersist();
        foreach (var dto in normalized)
        {
            dto.RoundNumber = _roundNum;
            await PairingService.CreateAsync(dto);
        }
    }

    private async Task StartRoundAsync()
    {

        // Check for duplicates
        if (!ArePairingsValid())
        {
            _notice = "Cannot have duplicate players in pairings";
            return;
        }

        // Check for minimum players
        if (!HasMinimumPlayers)
        {
            _notice = "You must add at least two players to be able to start this tournament.";
            return;
        }

        // normalize and save
        await NormalizeAndSavePairingsAsync();

        // Set tournament to in progress
        //if (_tournamentModel != null)
        //{
            _tournamentModel.TournamentInProgress = true;
            await TournamentService.UpdateAsync(_tournamentModel);
        //}

        // navigate to in-progress page or refresh
        NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
    }

    private void AssignPlayer(PairingSelection pairing, bool isPlayer1, string? value)
    {
        if (isPlayer1) 
            pairing.Player1Id = value; 
        else 
            pairing.Player2Id = value;

        // Handle duplicate detection and removal
        if (!string.IsNullOrWhiteSpace(value) && value != BYE)
        {
            // Clear the same player from the other slot in this pairing
            if (isPlayer1)
            {
                if (pairing.Player2Id == value)
                    pairing.Player2Id = null;
            }
            else
            {
                if (pairing.Player1Id == value)
                    pairing.Player1Id = null;
            }

            // Check for duplicates and remove them from other pairings
            foreach (var otherPairing in _pairings)
            {
                if (otherPairing == pairing) continue;

                if (otherPairing.Player1Id == value)
                    otherPairing.Player1Id = null;

                if (otherPairing.Player2Id == value)
                    otherPairing.Player2Id = null;
            }
        }

        // Clear the notice since the user is making changes
        _notice = null;
    }

    private async Task<HashSet<(int, int)>> GetExistingPairings()
    {
        var existing = await PairingService.GetAllWhereAsync(
            x => x.TournamentId == TournamentId);

        return existing
            .Where(x => x.PairingTp1.HasValue && x.PairingTp2.HasValue)
            .Select(x =>
            (
                Math.Min(x.PairingTp1!.Value, x.PairingTp2!.Value),
                Math.Max(x.PairingTp1!.Value, x.PairingTp2!.Value)
            ))
            .ToHashSet();
    }

    private async Task GenerateRoundRobinPairings()
    {
        _notice = null;

        var occurred = await GetExistingPairings();

        var players = _participants
            .Select(p => p.TournamentPlayerId)
            .ToList();

        // Check if any player has faced everyone else
        foreach (var player in players)
        {
            var opponentCount = occurred.Count(p =>
                p.Item1 == player || p.Item2 == player);

            if (opponentCount >= players.Count - 1)
            {
                _notice = "Cannot generate a unique pairing.";
                return;
            }
        }

        var rnd = new Random();

        const int maxAttempts = 1000;

        for (int attempt = 0; attempt < maxAttempts; attempt++)
        {
            var shuffled = players
                .OrderBy(_ => rnd.Next())
                .ToList();

            bool valid = true;

            for (int i = 0; i + 1 < shuffled.Count; i += 2)
            {
                var pair = (
                    Math.Min(shuffled[i], shuffled[i + 1]),
                    Math.Max(shuffled[i], shuffled[i + 1]));

                if (occurred.Contains(pair))
                {
                    valid = false;
                    break;
                }
            }

            if (!valid)
                continue;

            _pairings.Clear();

            for (int i = 0; i < shuffled.Count; i += 2)
            {
                _pairings.Add(new PairingSelection
                {
                    Player1Id = shuffled[i].ToString(),
                    Player2Id = i + 1 < shuffled.Count
                        ? shuffled[i + 1].ToString()
                        : BYE
                });
            }

            _pairingsAreValid = true;
            StateHasChanged();

            return;
        }

        _notice = "Cannot generate a unique pairing.";
        _pairingsAreValid = false;
    }

    private async Task GenerateSwissPairings()
    {
        _notice = null;

        var occurred = await GetExistingPairings();

        var players = _participants
            .OrderByDescending(p => p.PlayerSwissPoints ?? 0)
            .ThenByDescending(p => p.PlayerSwissMatchPoints ?? 0)
            .Select(p => p.TournamentPlayerId)
            .ToList();

        if (players.Count < 2)
        {
            _notice = "Not enough participants to generate pairings.";
            return;
        }

        var rnd = new Random();
        const int maxAttempts = 1000;

        for (int attempt = 0; attempt < maxAttempts; attempt++)
        {
            // Some small randomness within groups with similar scores
            var shuffled = players
                .OrderBy(x => rnd.Next())
                .ToList();

            bool valid = true;

            var pairs = new List<(int, int?)>();

            for (int i = 0; i < shuffled.Count; i += 2)
            {
                var p1 = shuffled[i];
                var p2 = i + 1 < shuffled.Count ? shuffled[i + 1] : (int?)null;

                if (p2 != null)
                {
                    var pair = (
                        Math.Min(p1, p2.Value),
                        Math.Max(p1, p2.Value));

                    if (occurred.Contains(pair))
                    {
                        valid = false;
                        break;
                    }

                    pairs.Add((p1, p2));
                }
                else
                {
                    pairs.Add((p1, null)); // BYE
                }
            }

            if (!valid)
                continue;

            _pairings.Clear();

            foreach (var (p1, p2) in pairs)
            {
                _pairings.Add(new PairingSelection
                {
                    Player1Id = p1.ToString(),
                    Player2Id = p2?.ToString() ?? BYE
                });
            }

            _pairingsAreValid = true;
            StateHasChanged();

            return;
        }

        _notice = "Failed to generate Swiss pairings without repeats.";
        _pairingsAreValid = false;
    }

    private bool AreAllPlayersAssigned()
    {
        // Check if every pairing has both players assigned (no empty selections)
        // BYE is allowed but actual players must be assigned
        return _pairings.All(p =>
        {
            bool p1HasValue = !string.IsNullOrWhiteSpace(p.Player1Id);
            bool p2HasValue = !string.IsNullOrWhiteSpace(p.Player2Id);
            return p1HasValue && p2HasValue;
        });
    }

    private bool ArePairingsValid()
    {
        // Check for duplicate players (only count non-BYE values)
        var assignedPlayers = new HashSet<string>();
        foreach (var pairing in _pairings)
        {
            if (!string.IsNullOrWhiteSpace(pairing.Player1Id) && pairing.Player1Id != BYE)
            {
                if (!assignedPlayers.Add(pairing.Player1Id))
                    return false; // Duplicate found
            }

            if (!string.IsNullOrWhiteSpace(pairing.Player2Id) && pairing.Player2Id != BYE)
            {
                if (!assignedPlayers.Add(pairing.Player2Id))
                    return false; // Duplicate found
            }
        }

        return true;
    }

    private bool CanStartMatch()
    {
        // Button is enabled if pairings are valid (generated) and no duplicates exist
        // Check for all players being assigned happens when the button is clicked
        return _pairingsAreValid && ArePairingsValid();
    }

    private HashSet<int> GetAssignedPlayers()
    {
        var assignedPlayers = new HashSet<int>();
        foreach (var pairing in _pairings)
        {
            if (!string.IsNullOrWhiteSpace(pairing.Player1Id) && pairing.Player1Id != BYE && int.TryParse(pairing.Player1Id, out var id1))
                assignedPlayers.Add(id1);

            if (!string.IsNullOrWhiteSpace(pairing.Player2Id) && pairing.Player2Id != BYE && int.TryParse(pairing.Player2Id, out var id2))
                assignedPlayers.Add(id2);
        }
        return assignedPlayers;
    }

    private (List<TournamentPlayerDto> unassigned, List<TournamentPlayerDto> assigned) GetPlayerLists()
    {
        var assignedPlayers = GetAssignedPlayers();
        var unassignedPlayers = _participants
            .Where(p => !assignedPlayers.Contains(p.TournamentPlayerId))
            .OrderBy(p => p.PlayerName)
            .ToList();
        var assignedPlayersList = _participants
            .Where(p => assignedPlayers.Contains(p.TournamentPlayerId))
            .OrderBy(p => p.PlayerName)
            .ToList();
        return (unassignedPlayers, assignedPlayersList);
    }

    private void OnPlayer1Changed(PairingSelection pairing, ChangeEventArgs args)
    {
        AssignPlayer(pairing, true, args.Value as string);
        StateHasChanged();
    }

    private void OnPlayer2Changed(PairingSelection pairing, ChangeEventArgs args)
    {
        AssignPlayer(pairing, false, args.Value as string);
        StateHasChanged();
    }
}
