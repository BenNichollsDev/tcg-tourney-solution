@page "/tournaments/view/{tournamentId:int}"
@using TCG.Application.Dtos
@using TCG.Application.Services
@using TCG.EMS.Components.Elements

@rendermode InteractiveServer

<div class="container-fluid py-4" style="max-width: 50%">
    <div class="row">
        <div class="col-12">
            <div class="bg-container p-4">
                @if (_notice != null)
                {
                    <div class="alert alert-warning">
                        @_notice
                    </div>
                }

                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h1 class="mb-3 text-center">@_tournamentModel?.TournamentName</h1>

                    <p>Start date: @_tournamentModel?.TournamentDate</p>
                    <p>Start time: @_tournamentModel?.TournamentTime</p>

                    <p>Round @_tournamentModel?.TournamentRoundNum</p>

                    <hr />

                    @if (_tournamentModel?.TournamentPairing == "Round-Robin")
                    {
                        <h2 class="mt-4">Pairings</h2>

                        @foreach (var pairing in _pairings)
                        {
                            <div class="d-flex gap-2 mb-2">

                                <select class="form-select"
                                        @bind="pairing.Player1Id"
                                        @bind:after="() => AssignPlayer(pairing, true, pairing.Player1Id)">

                                    <option value="">-- Player 1 --</option>

                                    @foreach (var p in _participants)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    <option value="@BYE">BYE</option>
                                </select>

                                <span class="align-self-center">VS</span>

                                <select class="form-select"
                                        @bind="pairing.Player2Id"
                                        @bind:after="() => AssignPlayer(pairing, false, pairing.Player2Id)">

                                    <option value="">-- Player 2 --</option>

                                    @foreach (var p in _participants)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    <option value="@BYE">BYE</option>
                                </select>

                            </div>
                        }

                        <hr />

                        <h2>Round Robin Standings</h2>

                        @* Use the shared StandingsTable component to display round-robin standings *@
                        <StandingsTable TournamentId="@TournamentId!.Value" RealTimeUpdate="@false" />
                                        <button class="btn btn-primary"
                                                @onclick="StartRoundAsync"
                                                disabled="@(!CanStartMatch() || HasInsufficientParticipants)">
                                            Start Round
                                    </button>

                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-secondary"
                                    @onclick="GenerateRoundRobinPairings"
                                    disabled="@HasInsufficientParticipants">
                                Generate Pairings
                            </button>
                        </div>

                        <!-- Disqualify control -->
                        <div class="mt-3 mb-3 d-flex gap-2 align-items-center">
                            <select class="form-select w-auto" @bind="_selectedToDisqualify">
                                <option value="">-- Select player to disqualify --</option>
                                @foreach (var p in _participants.Where(x => !x.TpDisqualified))
                                {
                                    <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                }
                            </select>
                            <button class="btn btn-danger" @onclick="DisqualifyPlayerAsync" disabled="@string.IsNullOrEmpty(_selectedToDisqualify)">Disqualify</button>

                            <!-- Drop control -->
                            <select class="form-select w-auto" @bind="_selectedToDrop">
                                <option value="">-- Select player to drop --</option>
                                @foreach (var p in _participants.Where(x => !x.TpDropped && !x.TpDisqualified))
                                {
                                    <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                }
                            </select>
                            <button class="btn btn-warning" @onclick="DropPlayerAsync" disabled="@string.IsNullOrEmpty(_selectedToDrop)">Drop</button>
                        </div>
                    }
                    else
                    {
                        <h5 class="mt-3">Pairings</h5>

                        @foreach (var pairing in _pairings)
                        {
                            <div class="d-flex gap-2 mb-2">

                                <select class="form-select"
                                        @bind="pairing.Player1Id"
                                        @bind:after="() => AssignPlayer(pairing, true, pairing.Player1Id)">

                                    <option value="">-- Player 1 --</option>

                                    @foreach (var p in _participants)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    <option value="@BYE">BYE</option>
                                </select>

                                <span class="align-self-center">VS</span>

                                <select class="form-select"
                                        @bind="pairing.Player2Id"
                                        @bind:after="() => AssignPlayer(pairing, false, pairing.Player2Id)">

                                    <option value="">-- Player 2 --</option>

                                    @foreach (var p in _participants)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    <option value="@BYE">BYE</option>
                                </select>

                            </div>
                        }

                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-primary"
                                    @onclick="StartRoundAsync"
                                    disabled="@(!CanStartMatch() || HasInsufficientParticipants)">
                                Start Round
                            </button>

                            <button class="btn btn-secondary"
                                    @onclick="GenerateSwissPairings"
                                    disabled="@HasInsufficientParticipants">
                                Generate Pairings
                            </button>

                            <!-- Disqualify control for swiss -->
                            <div class="ms-2">
                                <select class="form-select d-inline-block w-auto" @bind="_selectedToDisqualify">
                                    <option value="">-- Select player to disqualify --</option>
                                    @foreach (var p in _participants.Where(x => !x.TpDisqualified))
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }
                                </select>
                                <button class="btn btn-danger ms-2" @onclick="DisqualifyPlayerAsync" disabled="@string.IsNullOrEmpty(_selectedToDisqualify)">Disqualify</button>

                                <!-- Drop control for swiss -->
                                <select class="form-select d-inline-block w-auto ms-2" @bind="_selectedToDrop">
                                    <option value="">-- Select player to drop --</option>
                                    @foreach (var p in _participants.Where(x => !x.TpDropped && !x.TpDisqualified))
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }
                                </select>
                                <button class="btn btn-warning ms-2" @onclick="DropPlayerAsync" disabled="@string.IsNullOrEmpty(_selectedToDrop)">Drop</button>
                            </div>

                            @if (_tournamentModel!.TournamentRoundNum <= 1)
                            {
                                <button class="btn btn-secondary"
                                        @onclick="EndTournamentAsync">
                                    Cancel Tourney
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary"
                                        @onclick="EndTournamentAsync">
                                    End Tourney
                                </button>
                            }

                        </div>

                        <hr />

                        <h2 class="mt-4">Swiss Standings</h2>

                        @* Use the shared StandingsTable component to display Swiss standings *@
                        <StandingsTable TournamentId="@TournamentId.Value" RealTimeUpdate="@false" />
                    }
                }

                <div class="mt-3">
                    <NavLink class="btn btn-outline-dark" href="/tournaments">
                        Back
                    </NavLink>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    private const string BYE = "bye";

    private bool _hasLoaded;
    private bool _showNull;
    private string? _notice;

    // Check if there are fewer than two active participants (ignores disqualified/dropped)
    private bool HasInsufficientParticipants => _participants.Count(p => !p.TpDisqualified && !p.TpDropped) < 2;

    private bool _canTournamentEnd;
    private string? _selectedToDisqualify;
    private string? _selectedToDrop;

    private TournamentDto? _tournamentModel = new();

    private class PairingSelection
    {
        public string? Player1Id { get; set; }
        public string? Player2Id { get; set; }
    }

    private List<PairingSelection> _pairings = new();
    private List<TournamentPlayerDto> _participants = new();
    private Dictionary<int, ITournamentScoringService.PlayerComputedStats> _computedStats = new();

    [Parameter]
    public int? TournamentId { get; set; }

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;

    [Inject]
    private IPairingService PairingService { get; set; } = null!;

    [Inject]
    private TournamentScoringService ScoringService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _hasLoaded = false;
        _showNull = false;

        if (TournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);
        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        // If tournament is in progress, redirect to view page
        if (_tournamentModel.TournamentRoundInProgress)
        {
            NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
            return;
        }

        // If tournament has finished, redirect to results page
        if (_tournamentModel.TournamentFinished)
        {
            NavManager.NavigateTo($"/tournaments/results/{TournamentId}");
            return;
        }

        _canTournamentEnd = _tournamentModel.TournamentRoundNum > 1;

        _participants = (await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value)).ToList();

        // initialize pairings based on participants count
        _pairings = new List<PairingSelection>();
        int pairCount = _participants.Count / 2;
        for (int i = 0; i < pairCount; i++) _pairings.Add(new PairingSelection());

        // Compute standings - the service returns a dictionary
        var standingsList = await ScoringService.ComputeTournamentStandings(TournamentId.Value);
        _computedStats = standingsList ?? new Dictionary<int, ITournamentScoringService.PlayerComputedStats>();

        _hasLoaded = true;

        if (HasInsufficientParticipants)
            _notice = _notice == null
                ? "This tournament has fewer than two participants. More participants must be added to be able to start the tournament."
                : _notice + "\nThis tournament has fewer than two participants. More participants must be added to be able to start the tournament.";

    }

    // Normalise pairings so Player1 is always the actual player and Player2 is BYE if applicable
    private List<PairingDto> NormalizePairingsForPersist()
    {
        var result = new List<PairingDto>();
        foreach (var p in _pairings)
        {
            string? p1 = p.Player1Id;
            string? p2 = p.Player2Id;

            // Interpret BYE strings as null
            if (string.Equals(p1, BYE, StringComparison.OrdinalIgnoreCase)) p1 = null;
            if (string.Equals(p2, BYE, StringComparison.OrdinalIgnoreCase)) p2 = null;

            // If only one side has a player, ensure player is set to Player1 and Player2 is null (BYE)
            if (p1 == null && p2 != null)
            {
                // swap
                var temp = p1;
                p1 = p2;
                p2 = temp;
            }

            int? tp1 = null;
            int? tp2 = null;

            if (int.TryParse(p1, out var id1)) tp1 = id1;
            if (int.TryParse(p2, out var id2)) tp2 = id2;

            if (!tp1.HasValue)
                continue;

            result.Add(new PairingDto
            {
                TournamentId = TournamentId!.Value,
                Player1Id = tp1.Value,
                Player2Id = tp2
            });
        }

        return result;
    }

    private async Task NormalizeAndSavePairingsAsync()
    {
        var normalized = NormalizePairingsForPersist();
        foreach (var dto in normalized)
        {
            dto.RoundNumber = _tournamentModel!.TournamentRoundNum;
            await PairingService.CreateAsync(dto);
        }
    }

    private async Task StartRoundAsync()
    {
        // normalize and save
        await NormalizeAndSavePairingsAsync();

        // Match now in progress
        _tournamentModel!.TournamentRoundInProgress = true;
        await TournamentService.UpdateAsync(_tournamentModel);

        // navigate to in-progress page or refresh
        NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
    }

    private void AssignPlayer(PairingSelection pairing, bool isPlayer1, string? value)
    {
        if (isPlayer1)
            pairing.Player1Id = value;
        else
            pairing.Player2Id = value;

        _notice = null;

        if (IsRealPlayer(value))
        {
            foreach (var other in _pairings)
            {
                if (other == pairing)
                    continue;

                if (other.Player1Id == value)
                    other.Player1Id = null;

                if (other.Player2Id == value)
                    other.Player2Id = null;
            }
        }

        StateHasChanged();
    }

    // Updates pairings when a player is disqualified or dropped
    private void UpdatePairingsForRemovedPlayer(int playerId)
    {
        var playerIdStr = playerId.ToString();
        var pairingsToRemove = new List<PairingSelection>();

        foreach (var pairing in _pairings)
        {
            // Replace the removed player with BYE
            if (pairing.Player1Id == playerIdStr)
                pairing.Player1Id = BYE;
            if (pairing.Player2Id == playerIdStr)
                pairing.Player2Id = BYE;

            // Mark pairings with two BYEs for removal
            if (pairing.Player1Id == BYE && pairing.Player2Id == BYE)
                pairingsToRemove.Add(pairing);
        }

        // Remove empty pairings (both BYE)
        foreach (var pairing in pairingsToRemove)
            _pairings.Remove(pairing);
    }

    // This marks a selected player as disqualified and refreshes local data
    private async Task DisqualifyPlayerAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedToDisqualify))
            return;

        if (!int.TryParse(_selectedToDisqualify, out var playerId))
            return;

        var tp = _participants.FirstOrDefault(p => p.TournamentPlayerId == playerId);
        if (tp == null)
            return;

        tp.TpDisqualified = true;
        await TournamentPlayerService.UpdateAsync(tp);

        // Update pairings immediately
        UpdatePairingsForRemovedPlayer(playerId);

        // Refresh participants and stats
        _participants = (await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == TournamentId)).ToList();
        var standingsList1 = await ScoringService.ComputeTournamentStandings(TournamentId!.Value);
        _computedStats = standingsList1 ?? new Dictionary<int, ITournamentScoringService.PlayerComputedStats>();

        _selectedToDisqualify = null;
        StateHasChanged();
    }

    // This marks a selected player as dropped and refreshes local data
    private async Task DropPlayerAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedToDrop))
            return;

        if (!int.TryParse(_selectedToDrop, out var playerId))
            return;

        var tp = _participants.FirstOrDefault(p => p.TournamentPlayerId == playerId);
        if (tp == null)
            return;

        tp.TpDropped = true;
        await TournamentPlayerService.UpdateAsync(tp);

        // Update pairings immediately
        UpdatePairingsForRemovedPlayer(playerId);

        // Refresh participants and stats
        _participants = (await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == TournamentId)).ToList();
        var standingsList2 = await ScoringService.ComputeTournamentStandings(TournamentId!.Value);
        _computedStats = standingsList2 ?? new Dictionary<int, ITournamentScoringService.PlayerComputedStats>();

        _selectedToDrop = null;
        StateHasChanged();
    }

    private static bool IsRealPlayer(string? id) =>
        !string.IsNullOrWhiteSpace(id) &&
        !id.Equals(BYE, StringComparison.OrdinalIgnoreCase);

    private static bool IsBye(string? id) =>
        !string.IsNullOrWhiteSpace(id) &&
        id.Equals(BYE, StringComparison.OrdinalIgnoreCase);

    private static bool IsValidPairingForStart(PairingSelection pairing)
    {
        var p1Real = IsRealPlayer(pairing.Player1Id);
        var p2Real = IsRealPlayer(pairing.Player2Id);
        var p1Bye = IsBye(pairing.Player1Id);
        var p2Bye = IsBye(pairing.Player2Id);

        if (p1Real && p2Real)
            return pairing.Player1Id != pairing.Player2Id;

        if (p1Real && p2Bye)
            return true;

        if (p2Real && p1Bye)
            return true;

        return false;
    }

    private async Task<HashSet<(int, int)>> GetExistingPairings()
    {
        var existing = await PairingService.GetAllWhereAsync(
            x => x.TournamentId == TournamentId);

        return existing
            .Where(x => x.Player2Id.HasValue)
            .Select(x =>
            (
                Math.Min(x.Player1Id, x.Player2Id!.Value),
                Math.Max(x.Player1Id, x.Player2Id!.Value)
            ))
            .ToHashSet();
    }

    // This generates round-robin pairings and assigns a bye to the lowest-scoring player
    // who has not yet received a bye. If all players already had a bye then it aborts
    private async Task GenerateRoundRobinPairings()
    {
        _notice = null;

        if (HasInsufficientParticipants)
            return;

        // Determine bye limit based on game type (MTG: 3 byes, Pokémon: 1 bye)
        int byeLimit = string.Equals(_tournamentModel?.TournamentGame, "mtg", StringComparison.OrdinalIgnoreCase) ? 3 : 1;

        // Check if any active player has already reached the bye limit
        var activePlayers = _participants
            .Where(p => !p.TpDisqualified && !p.TpDropped)
            .ToList();

        if (activePlayers.Any(p => (p.PlayerBye ?? 0) >= byeLimit))
        {
            _notice = "At least one player already has " + (byeLimit == 1 ? "one" : "three") + " bye" + (byeLimit == 1 ? "" : "s") + ".";
            return;
        }

        var occurred = await GetExistingPairings();

        var players = activePlayers.Select(p => p.TournamentPlayerId).ToList();

        // Check if any player has faced everyone else
        foreach (var player in players)
        {
            var opponentCount = occurred.Count(p =>
                p.Item1 == player || p.Item2 == player);

            if (opponentCount >= players.Count - 1)
            {
                _notice = "Cannot generate a unique pairing.";
                return;
            }
        }

        // If odd number, choose bye candidate: lowest round-robin points who haven't received a bye
        int? byeCandidateId = null;
        if (players.Count % 2 == 1)
        {
            var candidate = activePlayers
                .OrderBy(p => p.PlayerRoundRobinPoints ?? 0)
                .ThenBy(p => p.TournamentPlayerId)
                .FirstOrDefault();

            byeCandidateId = candidate.TournamentPlayerId;

            // Mark the candidate as having a bye now
            candidate.TpBye = true;
            candidate.HasReceivedBye = true;
            await TournamentPlayerService.UpdateAsync(candidate);

            // remove the candidate from the players list for pairing
            players.Remove(byeCandidateId.Value);
        }

        var rnd = new Random();
        const int maxAttempts = 1000;

        for (int attempt = 0; attempt < maxAttempts; attempt++)
        {
            var shuffled = players
                .OrderBy(_ => rnd.Next())
                .ToList();

            bool valid = true;

            for (int i = 0; i + 1 < shuffled.Count; i += 2)
            {
                var pair = (
                    Math.Min(shuffled[i], shuffled[i + 1]),
                    Math.Max(shuffled[i], shuffled[i + 1]));

                if (occurred.Contains(pair))
                {
                    valid = false;
                    break;
                }
            }

            if (!valid)
                continue;

            _pairings.Clear();

            for (int i = 0; i < shuffled.Count; i += 2)
            {
                _pairings.Add(new PairingSelection
                {
                    Player1Id = shuffled[i].ToString(),
                    Player2Id = shuffled[i + 1].ToString()
                });
            }

            // If there was a bye candidate, append them with a BYE pairing
            if (byeCandidateId.HasValue)
            {
                _pairings.Add(new PairingSelection
                {
                    Player1Id = byeCandidateId.Value.ToString(),
                    Player2Id = BYE
                });
            }

            return;
        }

        _notice = "Cannot generate a unique pairing.";
    }

    // This generates swiss pairings but assigns a bye to the lowest-scoring player
    // who has not yet received a bye. If everyone already has a bye then it aborts.
    private async Task GenerateSwissPairings()
    {
        _notice = null;

        // Determine bye limit based on game type (MTG: 3 byes, Pokémon: 1 bye)
        int byeLimit = string.Equals(_tournamentModel?.TournamentGame, "mtg", StringComparison.OrdinalIgnoreCase) ? 3 : 1;

        // Check if any active player has already reached the bye limit
        var activePlayers = _participants
            .Where(p => !p.TpDisqualified && !p.TpDropped)
            .OrderByDescending(p => p.PlayerSwissPoints ?? 0)
            .ThenByDescending(p => p.PlayerSwissMatchPoints ?? 0)
            .ToList();

        if (activePlayers.Any(p => (p.PlayerBye ?? 0) >= byeLimit))
        {
            _notice = "At least one player already has " + (byeLimit == 1 ? "one" : "three") + " bye" + (byeLimit == 1 ? "" : "s") + ".";
            return;
        }

        var occurred = await GetExistingPairings();

        var players = activePlayers.Select(p => p.TournamentPlayerId).ToList();

        if (HasInsufficientParticipants)
            return;

        // If odd number, choose bye candidate: lowest swiss points who haven't received a bye
        int? byeCandidateId = null;
        if (players.Count % 2 == 1)
        {
            var candidate = activePlayers
                .OrderBy(p => p.PlayerSwissPoints ?? 0)
                .ThenBy(p => p.PlayerSwissMatchPoints ?? 0)
                .ThenBy(p => p.TournamentPlayerId)
                .FirstOrDefault();

            if (candidate == null)
            {
                _notice = "All players have already received a bye. Cannot generate new pairings.";
                return;
            }

            byeCandidateId = candidate.TournamentPlayerId;

            // Mark candidate as having a bye
            candidate.TpBye = true;
            candidate.HasReceivedBye = true;
            await TournamentPlayerService.UpdateAsync(candidate);

            // remove candidate for pairing
            players.Remove(byeCandidateId.Value);
        }

        var rnd = new Random();
        const int maxAttempts = 1000;

        for (int attempt = 0; attempt < maxAttempts; attempt++)
        {
            var shuffled = players
                .OrderBy(x => rnd.Next())
                .ToList();

            bool valid = true;

            var pairs = new List<(int, int?)>();

            for (int i = 0; i < shuffled.Count; i += 2)
            {
                var p1 = shuffled[i];
                var p2 = i + 1 < shuffled.Count ? shuffled[i + 1] : (int?)null;

                if (p2 != null)
                {
                    var pair = (
                        Math.Min(p1, p2.Value),
                        Math.Max(p1, p2.Value));

                    if (occurred.Contains(pair))
                    {
                        valid = false;
                        break;
                    }

                    pairs.Add((p1, p2));
                }
                else
                {
                    pairs.Add((p1, null)); // BYE
                }
            }

            if (!valid)
                continue;

            _pairings.Clear();

            foreach (var (p1, p2) in pairs)
            {
                _pairings.Add(new PairingSelection
                {
                    Player1Id = p1.ToString(),
                    Player2Id = p2?.ToString() ?? BYE
                });
            }

            // append bye pairing if assigned
            if (byeCandidateId.HasValue)
            {
                _pairings.Add(new PairingSelection
                {
                    Player1Id = byeCandidateId.Value.ToString(),
                    Player2Id = BYE
                });
            }

            return;
        }

        _notice = "Failed to generate swiss pairings without repeats.";
    }

    private bool CanStartMatch()
    {
        if (HasInsufficientParticipants)
            return false;

        return _pairings.Any(IsValidPairingForStart);
    }

    private async Task EndTournamentAsync()
    {
        // End tournament
        _tournamentModel!.TournamentStarted = false;

        if (_tournamentModel.TournamentRoundNum <= 1)
        {
            _tournamentModel.TournamentCancelled = true;
        }
        _tournamentModel.TournamentFinished = true;

        await TournamentService.UpdateAsync(_tournamentModel);

        // Navigate to results page or refresh
        NavManager.NavigateTo($"/tournaments/results/{TournamentId}");
    }
}