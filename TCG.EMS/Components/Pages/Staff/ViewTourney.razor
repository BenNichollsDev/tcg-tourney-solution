@page "/tournaments/view/{tournamentId:int}"
@using TCG.Application.Dtos
@using TCG.Application.Services

@rendermode InteractiveServer

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-container p-4">

                @if (_notice != null)
                {
                    <div class="alert alert-warning">
                        @_notice
                    </div>
                }

                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h1 class="mb-3 text-center">@_tournamentModel?.TournamentName</h1>

                    <p>Start date: @_tournamentModel?.TournamentDate</p>
                    <p>Start time: @_tournamentModel?.TournamentTime</p>

                    <p>Round @_tournamentModel?.TournamentRoundNum</p>

                    <hr />

                    @if (_tournamentModel?.TournamentPairing == "Round-Robin")
                    {
                        <h2 class="mt-4">Pairings</h2>

                        @foreach (var pairing in _pairings)
                        {
                            <div class="d-flex gap-2 mb-2">

                                <select class="form-select"
                                        @bind="pairing.Player1Id"
                                        @bind:after="() => AssignPlayer(pairing, true, pairing.Player1Id)">

                                    <option value="">-- Player 1 --</option>

                                    @foreach (var p in _participants)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    @if (pairing.Player2Id == BYE)
                                    {
                                        <option value="@BYE">BYE</option>
                                    }
                                </select>

                                <span class="align-self-center">VS</span>

                                <select class="form-select"
                                        @bind="pairing.Player2Id"
                                        @bind:after="() => AssignPlayer(pairing, false, pairing.Player2Id)">

                                    <option value="">-- Player 2 --</option>

                                    @foreach (var p in _participants)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    @if (pairing.Player1Id == BYE)
                                    {
                                        <option value="@BYE">BYE</option>
                                    }
                                </select>

                            </div>
                        }

                        <hr />

                        <h2>Round Robin Standings</h2>

                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>Player</th>
                                <th>Wins</th>
                                <th>Draws</th>
                                <th>Losses</th>
                                <th>Points</th>
                                <th>OMW%</th>
                            </tr>
                            </thead>

                            <tbody>
                            @foreach (var s in _computedStats)
                            {
                                var player = _participants.FirstOrDefault(x => x.TournamentPlayerId == s.TournamentPlayerId);
                                <tr>
                                    <td>@(player?.PlayerName ?? "Unknown")</td>
                                    <td>@s.Wins</td>
                                    <td>@s.Draws</td>
                                    <td>@s.Losses</td>
                                    <td>@s.Points</td>
                                    <td>@s.OmwPercent.ToString("0.00")</td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-primary"
                                    @onclick="GenerateRoundRobinPairings">
                                Generate Pairings and Start Round
                            </button>

                            <button class="btn btn-primary"
                                    @onclick="StartRoundAsync"
                                    disabled="@(!CanStartMatch())">
                                Start Round
                            </button>
                        </div>
                    }
                    else
                    {
                        <h5 class="mt-3">Pairings</h5>

                        @foreach (var pairing in _pairings)
                        {
                            <div class="d-flex gap-2 mb-2">

                                <select class="form-select"
                                        @bind="pairing.Player1Id"
                                        @bind:after="() => AssignPlayer(pairing, true, pairing.Player1Id)">

                                    <option value="">-- Player 1 --</option>

                                    @foreach (var p in _participants)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    @if (pairing.Player2Id == BYE)
                                    {
                                        <option value="@BYE">BYE</option>
                                    }
                                </select>

                                <span class="align-self-center">VS</span>

                                <select class="form-select"
                                        @bind="pairing.Player2Id"
                                        @bind:after="() => AssignPlayer(pairing, false, pairing.Player2Id)">

                                    <option value="">-- Player 2 --</option>

                                    @foreach (var p in _participants)
                                    {
                                        <option value="@p.TournamentPlayerId">@p.PlayerName</option>
                                    }

                                    @if (pairing.Player1Id == BYE)
                                    {
                                        <option value="@BYE">BYE</option>
                                    }
                                </select>

                            </div>
                        }

                        <div class="mt-3 d-flex gap-2">

                            <button class="btn btn-secondary"
                                    @onclick="GenerateSwissPairings">
                                Generate Pairings and Start Round
                            </button>

                            <button class="btn btn-primary"
                                    @onclick="StartRoundAsync"
                                    disabled="@(!CanStartMatch())">
                                Start Round
                            </button>

                        </div>

                        <hr />

                        <h2 class="mt-4">Swiss Standings</h2>

                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>Player</th>
                                <th>Points</th>
                                <th>Wins</th>
                                <th>Draws</th>
                                <th>Losses</th>
                                <th>Game Win %</th>
                                <th>OMW%</th>
                            </tr>
                            </thead>

                            <tbody>
                            @foreach (var s in _computedStats)
                            {
                                var player = _participants.FirstOrDefault(x => x.TournamentPlayerId == s.TournamentPlayerId);
                                <tr>
                                    <td>@(player?.PlayerName ?? "Unknown")</td>
                                    <td>@s.Points</td>
                                    <td>@s.Wins</td>
                                    <td>@s.Draws</td>
                                    <td>@s.Losses</td>
                                    <td>@s.GameWinPercent.ToString("0.00")</td>
                                    <td>@s.OmwPercent.ToString("0.00")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                }

                <div class="mt-3">
                    <NavLink class="btn btn-outline-dark" href="/tournaments">
                        Back
                    </NavLink>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    private const string BYE = "bye";

    private bool _hasLoaded;
    private bool _showNull;
    private string? _notice;

    private TournamentDto? _tournamentModel = new();

    private class PairingSelection
    {
        public string? Player1Id { get; set; }
        public string? Player2Id { get; set; }
    }

    private List<PairingSelection> _pairings = new();
    private List<TournamentPlayerDto> _participants = new();
    private List<TournamentScoringService.PlayerComputedStats> _computedStats = new();

    [Parameter]
    public int? TournamentId { get; set; }

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;

    [Inject]
    private IPairingService PairingService { get; set; } = null!;

    [Inject]
    private TournamentScoringService ScoringService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _hasLoaded = false;
        _showNull = false;

        if (TournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);
        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _participants = (await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == TournamentId.Value)).ToList();

        // initialize pairings based on participants count
        _pairings = new List<PairingSelection>();
        int pairCount = _participants.Count / 2;
        for (int i = 0; i < pairCount; i++) _pairings.Add(new PairingSelection());

        _computedStats = await ScoringService.ComputeAllAsync(TournamentId.Value);

        _hasLoaded = true;
    }

    // Normalize pairings so Player1 is always the actual player and Player2 is BYE if applicable
    private List<PairingDto> NormalizePairingsForPersist()
    {
        var result = new List<PairingDto>();
        foreach (var p in _pairings)
        {
            string? p1 = p.Player1Id;
            string? p2 = p.Player2Id;

            // Interpret BYE strings as null
            if (string.Equals(p1, BYE, StringComparison.OrdinalIgnoreCase)) p1 = null;
            if (string.Equals(p2, BYE, StringComparison.OrdinalIgnoreCase)) p2 = null;

            // If only one side has a player, ensure player is set to Player1 and Player2 is null (BYE)
            if (p1 == null && p2 != null)
            {
                // swap
                var temp = p1;
                p1 = p2;
                p2 = temp;
            }

            int? tp1 = null;
            int? tp2 = null;

            if (int.TryParse(p1, out var id1)) tp1 = id1;
            if (int.TryParse(p2, out var id2)) tp2 = id2;

            result.Add(new PairingDto
            {
                PairingTournamentId = TournamentId,
                PairingTp1 = tp1,
                PairingTp2 = tp2
            });
        }

        return result;
    }

    private async Task NormalizeAndSavePairingsAsync()
    {
        var normalized = NormalizePairingsForPersist();
        foreach (var dto in normalized)
        {
            await PairingService.CreateAsync(dto);
        }
    }

    private async Task StartRoundAsync()
    {
        // normalize and save
        await NormalizeAndSavePairingsAsync();

        // navigate to in-progress page or refresh
        NavManager.NavigateTo($"/tournaments/inprogress/{TournamentId}");
    }

    private void AssignPlayer(PairingSelection pairing, bool isPlayer1, string? value)
    {
        if (isPlayer1) pairing.Player1Id = value; else pairing.Player2Id = value;
    }

    private void GenerateRoundRobinPairings()
    {
        // simple round robin generator: pair sequentially
        _pairings.Clear();
        for (int i = 0; i < _participants.Count; i += 2)
        {
            var p1 = _participants[i];
            var p2 = i + 1 < _participants.Count ? _participants[i + 1] : null;

            _pairings.Add(new PairingSelection
            {
                Player1Id = p1.TournamentPlayerId.ToString(),
                Player2Id = p2?.TournamentPlayerId.ToString() ?? BYE
            });
        }
    }

    private void GenerateSwissPairings()
    {
        // simple swiss: use computed stats order
        var ordered = _computedStats.Select(s => s.TournamentPlayerId).ToList();
        _pairings.Clear();
        for (int i = 0; i < ordered.Count; i += 2)
        {
            var p1 = ordered[i];
            var p2 = i + 1 < ordered.Count ? ordered[i + 1] : (int?)null;
            _pairings.Add(new PairingSelection
            {
                Player1Id = p1.ToString(),
                Player2Id = p2?.ToString() ?? BYE
            });
        }
    }

    private bool CanStartMatch()
    {
        // ensure all pairings have at least one player
        return _pairings.All(p => !string.IsNullOrWhiteSpace(p.Player1Id) || !string.IsNullOrWhiteSpace(p.Player2Id));
    }
}
