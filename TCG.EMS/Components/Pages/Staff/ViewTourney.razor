@page "/tournaments/view/{tournamentId:int}"
@using TCG.Application.Dtos

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-container p-4">
                @if (!_hasLoaded)
                {
                    <p>Loading...</p>
                }
                else if (_showNull)
                {
                    <h2>No tournament data found.</h2>
                }
                else
                {
                    <h1 class="mb-3 text-center">@_tournamentModel.TournamentName</h1>
                    <p>Start date: @_tournamentModel.TournamentDate</p>
                    <p>Start time: @_tournamentModel.TournamentTime</p>
                    
                    <h3>Participants</h3>
                    <p>Unpaired Participants: </p>
                    //AUTO DO PAIRINGS HERE
                    
                    @for (var i = 0; i < _possibleNumOfPairings; i++)
                    {
                        <div>
                            <EditForm>
                                <InputSelect id="games"
                                             class="form-control mb-3">
                                    <option value="">-- Select --</option>
                                    
                                    @foreach (var participant in _unpairedParticipants)
                                    {
                                        <option value="participant">participant</option>
                                    }
                                    
                                    @if (_isOddNumOfParticipants && _unpairedParticipants.Count == 1)
                                    {
                                        <option value="bye">Bye</option>
                                    }
                                    
                                    <!--THIS IS FOR SWISS PAIRINGS
                                    ADD IN LOGIC TO MAKE ALLOW FOR THE LIST OF PARTICIPANTS TO DECREASE WHEN A PARTICIPANT IS SELECTED IN THE ABOVE INDIVIDUAL EDIT FORMS
                                    ADD SUPPORT FOR BYES
                                    AND ONLY ALLOW THE MATCH TO START WHEN ALL PLAYERS ARE ASSIGNED

                                    CONSIDER MAKING THE ABOVE EDIT FORM TO BE ONLY ONE INSTANCE INSTEAD OF FOR EACH PAIRING MAYBE

                                    WHEN THIS IS DONE, MAKE FUNCTIONALITY FOR ROUND ROBIN PAIRINGS TOO DEPENDING ON THE MATCH TYPE-->
                                    
                                </InputSelect>
                            </EditForm>
                        </div>
                    }
                    
                    <button type="button" class="btn btn-secondary">
                        Back
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool _hasLoaded;
    private bool _showNull;

    [Parameter]
    public int? TournamentId { get; set; }

    private TournamentDto? _tournamentModel = new();

    [Inject]
    private ITournamentService TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService TournamentPlayerService { get; set; } = null!;
    
    private List<TournamentPlayerDto> _participants = new();
    private List<TournamentPlayerDto> _unpairedParticipants = new();

    private int _possibleNumOfPairings;
    private bool _isOddNumOfParticipants = false;
    
    protected override void OnInitialized()
    {
        _hasLoaded = false;
        _showNull = false;
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        if (TournamentId == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        _tournamentModel = await TournamentService.GetByIdAsync(TournamentId.Value);
        if (_tournamentModel == null)
        {
            _showNull = true;
            _hasLoaded = true;
            return;
        }

        var allPlayers = await TournamentPlayerService.GetAllAsync();
        _participants = allPlayers.Where(p => p.TpTournament == TournamentId.Value).ToList();
        _unpairedParticipants = _participants;
        
        _isOddNumOfParticipants = _participants.Count % 2 != 0;

        _possibleNumOfPairings = _isOddNumOfParticipants
            ? _participants.Count - 1
            : _participants.Count;
        
        _hasLoaded = true;
    }
}