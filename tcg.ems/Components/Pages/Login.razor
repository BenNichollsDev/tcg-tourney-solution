@page "/"

@using Microsoft.AspNetCore.Identity
@using TCG.Application.Dtos
@using TCG.Application.Services
@inject NavigationManager NavManager

<div class="d-flex justify-content-center align-items-center vh-100">

	@if (editContext == null)
	{
		<h3>Loading...</h3>
	}
	else
	{
		<h3>TCGTourneys</h3>

		<EditForm EditContext="@editContext">
			<DataAnnotationsValidator />
			<p>17cities@mail.com</p>
			<p>@hasher.HashPassword(null, "123");</p>

			<p>blackmesa@mail.com</p>
			<p>@hasher.HashPassword(null, "456");</p>

			<p>ravenholm@mail.com</p>
			<p>@hasher.HashPassword(null, "789");</p>

			<label>Email:</label>
			<InputText @bind-Value="emailInput" />

			@* Reminder hash password *@
			<label>Password:</label>
			<InputText @bind-Value="passwordInput" type="password" />

			<input type="submit" value="Submit" class="btn btn-primary" />
		</EditForm>
	}
</div>

@code {
	protected internal EditContext? editContext;

	protected internal StaffDto Staff { get; set; } = new();

	// var staffList = await StaffService.GetAllAsync();

	protected internal string emailInput = string.Empty;
	protected internal string passwordInput = string.Empty;

	PasswordHasher<object> hasher = new PasswordHasher<object>();

	protected override async Task OnInitializedAsync()
	{
		editContext = new EditContext(Staff);
	}
}
