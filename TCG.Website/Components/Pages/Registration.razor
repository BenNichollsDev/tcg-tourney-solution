@page "/register/{tournamentId:int}"
@using System.ComponentModel.DataAnnotations
@using TCG.Application.Dtos
@using TCG.Application.Interfaces.Services
@inject IPlayerService PlayerService
@inject ITournamentService TournamentService
@inject ITournamentPlayerService TournamentPlayerService
@inject NavigationManager NavManager
@inject PlayerSessionService PlayerSession
@rendermode InteractiveServer

<PageTitle>Angels of Cards | Register for Tournament</PageTitle>

<div class="ms-3 me-3">
    <div class="ps-3 pe-3 pt-3 pb-3">
        @if (!_hasLoaded)
        {
            <p>Loading...</p>
        }
        else if (!PlayerSession.IsLoggedIn)
        {
            <div class="alert alert-info">
                <p>You need to be logged in to register for tournaments.</p>
                <NavLink href="login-signup" class="btn btn-primary">Go to Login/Sign Up</NavLink>
            </div>
        }
        else if (_tournament is null)
        {
            <h2>Tournament not found</h2>
        }
        else if (_alreadyParticipant)
        {
            <div class="alert alert-info">You are already registered for this tournament.</div>
        }
        else if (_tournament.TournamentStarted || _tournament.TournamentCancelled || _tournament.TournamentFinished)
        {
            <div class="alert alert-warning">This tournament cannot be joined.</div>
        }
        else if (_participantCount >= _tournament.TournamentMaxParticipants)
        {
            <div class="alert alert-warning">Tournament is full.</div>
        }
        else
        {
            <h3>Welcome back, @PlayerSession.PlayerName</h3>
            <p>Click to join the tournament:</p>
            <button class="btn btn-primary" @onclick="JoinAsLoggedIn">Join Tournament</button>
        }

        <div class="mt-3">
            <NavLink href="@($"/viewevent/{tournamentId}")" class="btn btn-secondary">Back</NavLink>
        </div>

    </div>
</div>

@code {
    [Parameter]
    public int tournamentId { get; set; }

    private TournamentDto? _tournament = new();

    private bool _hasLoaded = false;
    private bool _alreadyParticipant = false;
    private int _participantCount = 0;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _tournament = await TournamentService.GetByIdAsync(tournamentId);

        var tps = await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == tournamentId);
        _participantCount = tps.Count();

        if (PlayerSession.IsLoggedIn)
        {
            _alreadyParticipant = tps.Any(tp => tp.PlayerId == PlayerSession.PlayerId);
        }

        _hasLoaded = true;
    }

    private async Task JoinAsLoggedIn()
    {
        try
        {
            var freshTournament = await TournamentService.GetByIdAsync(tournamentId);
            var freshCount = (await TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == tournamentId)).Count();

            if (freshTournament == null || freshTournament.TournamentStarted || freshTournament.TournamentCancelled || freshTournament.TournamentFinished)
                throw new Exception("Tournament cannot be joined.");

            if (freshCount >= freshTournament.TournamentMaxParticipants)
                throw new Exception("Tournament is full.");

            var newTp = new TournamentPlayerDto
            {
                TournamentId = tournamentId,
                PlayerId = PlayerSession.PlayerId ?? 0,
                PlayerName = PlayerSession.PlayerName ?? ""
            };

            await TournamentPlayerService.CreateAsync(newTp);

            NavManager.NavigateTo($"/viewevent/{tournamentId}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}


