@page "/viewevent/{tournamentId:int}"
@using TCG.Website.Components.Elements
@rendermode InteractiveServer

<div class="ms-3 me-3">
    <PageTitle>Angels of Cards | ifthereisnotourney then it says tourney not found, otherwise Tourney: @_tournament!.TournamentName</PageTitle>

    @if (!_hasDataLoaded)
    {
        <p>Loading event data...</p>
    }
    else
    {
        if (_tournament! is null)
        {
            <h1>Event not found.</h1>
        }
        else
        {
            <h1>@_tournament!.TournamentName</h1>
            <h3>@_tournament!.TournamentGame</h3>
            <h3>@_tournament!.TournamentFormat</h3>
            <h3>@_tournament.TournamentDate.ToString("dd MMM yyyy") at @_tournament.TournamentTime</h3>

            <h3>Entry Fee: @_tournament!.TournamentEntryFee</h3>

            <p>@_tournament!.TournamentDescription</p>

            <br />

            @if (_participantNames == null || !_participantNames.Any())
            {
                <p>No participants yet.</p>
            }
            else
            {
                <p>Participants: @_participantNames.Count / @_tournament!.TournamentMaxParticipants</p>
            }

            @if (!_tournament.TournamentStarted
                && !_tournament.TournamentCancelled
                && !_tournament.TournamentFinished
                && (_participantNames is null || _participantNames.Count < _tournament.TournamentMaxParticipants))
            {
                <NavLink href="@($"/register/{_tournament.TournamentId}")" class="btn btn-primary">Sign up</NavLink>
            }

            <h2>
                Standings
            </h2>
            @* Use real-time updates so spectators see live standings changes *@
            <StandingsTable TournamentId="@_tournament.TournamentId" RealTimeUpdate="@true" />
        }
    }

</div>

@code {
    [Parameter]
    public int tournamentId { get; set; }

    [Inject]
    private ITournamentService _TournamentService { get; set; } = null!;

    [Inject]
    private ITournamentPlayerService _TournamentPlayerService { get; set; } = null!;

    private TournamentDto? _tournament = new();

    private bool _loadingTournament = true;
    private bool _hasDataLoaded = false;

    private List<TournamentPlayerDto> _participantNames = new();

    protected override async Task OnInitializedAsync()
    {
        _tournament = await _TournamentService.GetByIdAsync(tournamentId);

        if (_tournament != null)
        {
            _participantNames = (await _TournamentPlayerService.GetAllWhereAsync(tp => tp.TournamentId == _tournament.TournamentId)).ToList();
        }

        _hasDataLoaded = true;
    }
}

