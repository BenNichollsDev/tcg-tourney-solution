@page "/login-signup"
@page "/login"
@rendermode InteractiveServer

<PageTitle>Angels of Cards | Login / Sign Up</PageTitle>

<div class="d-flex flex-column justify-content-center align-items-center min-vh-100">
    <div class="ps-3 pe-3 pt-3 pb-3 text-center events-preview">

        <h1 class="mb-3">Angels of Cards</h1>

        @if (_showLogin)
        {
            <form method="post" action="/auth/login">
                <label>Email:</label>
                <input name="Email"
                       class="form-control mb-3"
                       required />

                <label>Password:</label>
                <input name="Password"
                       type="password"
                       class="form-control mb-3"
                       required />

                <button type="submit" class="btn btn-primary">
                    Login
                </button>
            </form>

            @if (!string.IsNullOrWhiteSpace(loginError))
            {
                <div class="text-danger mt-2">@loginError</div>
            }

            <div class="text-center mt-3">
                <p>Don't have an account? <button class="btn btn-link p-0" @onclick="() => _showLogin = false">Sign Up</button></p>
            </div>
        }
        else
        {
            <form method="post" action="/auth/signup">
                <div class="mb-3">
                    <label>First Name:</label>
                    <input name="PlayerFirstName"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label>Last Name:</label>
                    <input name="PlayerLastName"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label>Email:</label>
                    <input name="PlayerEmail"
                           type="email"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label>Phone:</label>
                    <input name="PlayerPhone"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Date of Birth:</label>
                    <input name="PlayerDOB"
                           type="date"
                           class="form-control" />
                </div>


                <button type="submit" class="btn btn-primary w-100">
                    Create Account
                </button>
            </form>

            @if (!string.IsNullOrWhiteSpace(signupError))
            {
                <div class="text-danger mt-2">@signupError</div>
            }

            <div class="text-center mt-3">
                <p>Already have an account? <button class="btn btn-link p-0" @onclick="() => _showLogin = true">Login</button></p>
            </div>
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? error { get; set; }

    [SupplyParameterFromQuery(Name = "signupError")]
    public string? signupErrorQuery { get; set; }

    private bool _showLogin = true;
    private string? loginError;
    private string? signupError;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(error))
        {
            loginError = "Invalid login attempt.\nPlease check your email and password.";
        }
        else
        {
            loginError = null;
        }

        if (!string.IsNullOrWhiteSpace(signupErrorQuery))
        {
            signupError = signupErrorQuery;
            // Display signup form if there was an error creating account
            _showLogin = false;
        }
        else
        {
            signupError = null;
        }
    }
}
