@page "/login-signup"
@page "/login"
@using System.ComponentModel.DataAnnotations
@using TCG.Application.Dtos
@using TCG.Application.Interfaces.Services
@rendermode InteractiveServer

<PageTitle>Angels of Cards | Login / Sign Up</PageTitle>

<div class="d-flex flex-column justify-content-center align-items-center min-vh-100">
    <div class="ps-3 pe-3 pt-3 pb-3 text-center events-preview">

        <h1 class="mb-3">Angels of Cards</h1>

        @if (_showLogin)
        {
            <form method="post" action="/auth/login">
                <label>Email:</label>
                <input name="Email"
                       class="form-control mb-3"
                       required />

                <label>Password:</label>
                <input name="Password"
                       type="password"
                       class="form-control mb-3"
                       required />

                <button type="submit" class="btn btn-primary">
                    Login
                </button>
            </form>

            @if (!string.IsNullOrWhiteSpace(loginError))
            {
                <div class="text-danger mt-2">@loginError</div>
            }

            <div class="text-center mt-3">
                <p>Don't have an account? <button class="btn btn-link p-0" @onclick="() => _showLogin = false">Sign Up</button></p>
            </div>
        }
        else
        {
            <EditForm Model="@_playerModel" OnValidSubmit="OnFormSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="firstname">First Name:</label>
                    <InputText id="firstname"
                               class="form-control"
                               @bind-Value="_playerModel.PlayerFirstName" />
                    <ValidationMessage For="@(() => _playerModel.PlayerFirstName)" />
                </div>

                <div class="mb-3">
                    <label for="lastname">Last Name:</label>
                    <InputText id="lastname"
                               class="form-control"
                               @bind-Value="_playerModel.PlayerLastName" />
                    <ValidationMessage For="@(() => _playerModel.PlayerLastName)" />
                </div>

                <div class="mb-3">
                    <label for="email">Email:</label>
                    <InputText id="email"
                               type="email"
                               class="form-control"
                               @bind-Value="_playerModel.PlayerEmail" />
                    <ValidationMessage For="@(() => _playerModel.PlayerEmail)" />
                </div>

                <div class="mb-3">
                    <label for="phone">Phone:</label>
                    <InputText id="phone"
                               class="form-control"
                               @bind-Value="_playerModel.PlayerPhone" />
                    <ValidationMessage For="@(() => _playerModel.PlayerPhone)" />
                </div>

                <div class="mb-3">
                    <label for="dob">Date of Birth:</label>
                    <InputDate id="dob"
                               class="form-control"
                               @bind-Value="_playerModel.PlayerDOB" />
                    <ValidationMessage For="@(() => _playerModel.PlayerDOB)" />
                </div>

                <div class="mb-3">
                    <label for="password">Password:</label>
                    <InputText id="password"
                               type="password"
                               class="form-control"
                               @bind-Value="_playerModel.PlayerPassword" />
                    <ValidationMessage For="@(() => _playerModel.PlayerPassword)" />
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Create Account
                </button>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(signupError))
            {
                <div class="text-danger mt-2">@signupError</div>
            }

            <div class="text-center mt-3">
                <p>Already have an account? <button class="btn btn-link p-0" @onclick="() => _showLogin = true">Login</button></p>
            </div>
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? error { get; set; }

    [SupplyParameterFromQuery(Name = "signupError")]
    public string? signupErrorQuery { get; set; }

    @inject IPlayerService PlayerService
    @inject NavigationManager NavManager

    private bool _showLogin = true;
    private string? loginError;
    private string? signupError;
    private PlayerDto _playerModel = new();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(error))
        {
            loginError = "Invalid login attempt.\nPlease check your email and password.";
        }
        else
        {
            loginError = null;
        }

        if (!string.IsNullOrWhiteSpace(signupErrorQuery))
        {
            signupError = signupErrorQuery;
            _showLogin = false;
        }
        else
        {
            signupError = null;
        }
    }

    private async Task OnFormSubmit()
    {
        try
        {
            await PlayerService.CreateAsync(_playerModel);
            NavManager.NavigateTo("/");
        }
        catch (ValidationException ex)
        {
            signupError = ex.Message;
        }
        catch (Exception ex)
        {
            signupError = "An error occurred while creating your account: " + ex.Message;
        }
    }
}
