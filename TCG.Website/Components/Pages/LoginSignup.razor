@page "/login-signup"
@using System.ComponentModel.DataAnnotations
@using TCG.Application.Dtos
@using TCG.Application.Interfaces.Services
@inject IPlayerService PlayerService
@inject NavigationManager NavManager
@inject PlayerSessionService PlayerSession
@rendermode InteractiveServer

<PageTitle>Angels of Cards | Login / Sign Up</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @if (_showLogin)
            {
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4>Login</h4>
                    </div>
                    <div class="card-body">
                        <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <InputText class="form-control" id="email" @bind-Value="_loginModel.Email" />
                                <ValidationMessage For="() => _loginModel.Email" />
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <InputText class="form-control" id="password" type="password" @bind-Value="_loginModel.Password" />
                                <ValidationMessage For="() => _loginModel.Password" />
                            </div>

                            @if (!string.IsNullOrEmpty(_error))
                            {
                                <div class="alert alert-danger">@_error</div>
                            }

                            <button type="submit" class="btn btn-primary w-100">Login</button>
                        </EditForm>

                        <div class="text-center mt-3">
                            <p>Don't have an account? <button class="btn btn-link p-0" @onclick="() => _showLogin = false">Sign Up</button></p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4>Sign Up</h4>
                    </div>
                    <div class="card-body">
                        <EditForm Model="_signupModel" OnValidSubmit="HandleSignup">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="firstName" class="form-label">First Name</label>
                                <InputText class="form-control" id="firstName" @bind-Value="_signupModel.PlayerFirstName" />
                                <ValidationMessage For="() => _signupModel.PlayerFirstName" />
                            </div>

                            <div class="mb-3">
                                <label for="lastName" class="form-label">Last Name</label>
                                <InputText class="form-control" id="lastName" @bind-Value="_signupModel.PlayerLastName" />
                                <ValidationMessage For="() => _signupModel.PlayerLastName" />
                            </div>

                            <div class="mb-3">
                                <label for="signupEmail" class="form-label">Email</label>
                                <InputText class="form-control" id="signupEmail" @bind-Value="_signupModel.PlayerEmail" />
                                <ValidationMessage For="() => _signupModel.PlayerEmail" />
                            </div>

                            <div class="mb-3">
                                <label for="phone" class="form-label">Phone</label>
                                <InputText class="form-control" id="phone" @bind-Value="_signupModel.PlayerPhone" />
                                <ValidationMessage For="() => _signupModel.PlayerPhone" />
                            </div>

                            <div class="mb-3">
                                <label for="dob" class="form-label">Date of Birth</label>
                                <InputDate class="form-control" id="dob" @bind-Value="_signupModel.PlayerDOB" />
                                <ValidationMessage For="() => _signupModel.PlayerDOB" />
                            </div>

                            <div class="mb-3">
                                <label for="gender" class="form-label">Gender</label>
                                <InputText class="form-control" id="gender" @bind-Value="_signupModel.PlayerGender" />
                            </div>

                            @if (!string.IsNullOrEmpty(_error))
                            {
                                <div class="alert alert-danger">@_error</div>
                            }

                            <button type="submit" class="btn btn-primary w-100">Create Account</button>
                        </EditForm>

                        <div class="text-center mt-3">
                            <p>Already have an account? <button class="btn btn-link p-0" @onclick="() => _showLogin = true">Login</button></p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private PlayerDto _signupModel = new();
    private bool _showLogin = true;
    private string? _error;

    private class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }

    private async Task HandleLogin()
    {
        try
        {
            _error = null;
            var player = await PlayerService.GetByAsync(p => p.PlayerEmail == _loginModel.Email);

            if (player == null)
            {
                _error = "Email or password is incorrect.";
                return;
            }

            var isValidPassword = await PlayerService.VerifyPasswordAsync(player.PlayerId, _loginModel.Password);
            if (!isValidPassword)
            {
                _error = "Email or password is incorrect.";
                return;
            }

            PlayerSession.PlayerId = player.PlayerId;
            PlayerSession.PlayerName = $"{player.PlayerFirstName} {player.PlayerLastName}";
            PlayerSession.PlayerEmail = player.PlayerEmail;

            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task HandleSignup()
    {
        try
        {
            _error = null;
            var newPlayer = await PlayerService.CreateWithDefaultPasswordAsync(_signupModel);

            PlayerSession.PlayerId = newPlayer.PlayerId;
            PlayerSession.PlayerName = $"{newPlayer.PlayerFirstName} {newPlayer.PlayerLastName}";
            PlayerSession.PlayerEmail = newPlayer.PlayerEmail;

            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}

