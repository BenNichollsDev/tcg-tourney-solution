@page "/"
@rendermode InteractiveServer

<div>
    <PageTitle>Angels of Cards | Home</PageTitle>

    <h1>Welcome to Angels of Cards</h1>

    @if (!_hasDataLoaded)
    {
        <p>Loading event data...</p>
    }
    else
    {
        @if (_tournaments!.Count == 0)
        {
            <div class="" style="width: 80%">
                <h2>Upcoming Events</h2>

                @foreach (var tournament in _tournaments)
                {
                    <div class="ps-2 pe-2" style="">
                        <h3>
                            @tournament.TournamentName
                        </h3>
                    </div>
                }
            </div>
        }
    }

    
</div>

@code {
    [Inject]
    private ITournamentService TournamentService { get; set; } = default!;

    private bool _hasDataLoaded = false;
    private bool _isViewingTourneys = false;
    private bool _isViewingLeagues = false;

    private List<TournamentDto> _tournaments;

    protected override async Task OnInitializedAsync()
    {
        _tournaments = (List<TournamentDto>?)await TournamentService.GetAllAsync();

        // var leagues = await LeagueService.GetAllAsync();
        // _leagueLookup = leagues.ToDictionary(league => league.LeagueId);

        _hasDataLoaded = true;
    }
}