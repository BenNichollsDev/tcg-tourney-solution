@page "/"
@page "/home"
@rendermode InteractiveServer

<PageTitle>Angels of Cards | Home</PageTitle>

<div class="ms-3 me-3 mt-5">
    <div class="ps-3 pe-3 pt-3 pb-3">

        <div class="content-section-right">
            <div class="content-image">
                <!-- Image placeholder on the left -->
            </div>
            <div class="content-text text-center">
                <h1>Angels of Cards</h1>
                <h2 class="mt-5">A Heaven for tabletop and trading card game fans, based in Northampton.</h2>

                <p class="mt-5">
                    We are located just behind the Northampton Bus Station. We provide a space for 
                    all of your nerdy needs, from tabletop games to trading card games. 
                    We host tournaments and leagues for a variety of games, and we have a friendly
                    community of players who are always happy to welcome new members.
                </p>
            </div>
        </div>

        <div class="content-section-left mt-5">
            <div class="content-text text-center">
                <p>
                    We also sell a variety of games and accessories, such as wargames, TCGs, and
                    more! So if you're looking for a new game to play or a new deck to build,
                    we've got you sorted.
                </p>
            </div>
            <div class="content-image">
                <!-- Image placeholder on the right -->
            </div>
        </div>
    </div>

</div>

<div class="events-preview">
    <div class="ps-3 pe-3 pt-3 pb-3 text-center">
        <h2>Events</h2>
        <div class="events-grid">
        <div class="ongoing-section">
            <h3>Ongoing</h3>
            @if (_activeTourneys!.Any())
            {
                @foreach(var t in _activeTourneys!)
                {
                    <NavLink class="event ongoing text-center" href="@($"/viewevent/{t.TournamentId}")">
                        <div>@t.TournamentName</div>
                        <div>@(t.TournamentGame=="mtg"?"Magic the Gathering":"Pokémon")</div>
                    </NavLink>
                }
            }
            else
            {
                <div>No ongoing tournaments...</div>
            }
        </div>

        <div class="upcoming-column">
            <h3>Upcoming</h3>
            @if (_tournamentsToDisplay!.Any())
            {
                <div class="col-grid">
                    @foreach(var t in _tournamentsToDisplay!)
                    {
                        <NavLink class="event card text-center" href="@($"/viewevent/{t.TournamentId}")">
                            <div>@t.TournamentName</div>
                            <div>@t.TournamentDate.ToString("dd MMM")</div>
                        </NavLink>
                    }
                </div>
            }
            else
            {
                <div>No upcoming tournaments yet...</div>
            }
        </div>

        <div class="recent-column">
            <h3>Recent</h3>
            @if (_recentTourneys!.Any())
            {
                <div class="col-grid">
                    @foreach(var t in _recentTourneys!)
                    {
                        <NavLink class="event card" href="@($"/viewevent/{t.TournamentId}")">
                            <div>@t.TournamentName</div>
                            <div>@t.TournamentDate.ToString("dd MMM")</div>
                        </NavLink>
                    }
                </div>
            }
            else
            {
                <div>No recent tournaments.</div>
            }
        </div>
    </div>
</div>
    </div>

@code {
    [Inject]
    private ITournamentService TournamentService { get; set; } = default!;

    [Inject]
    private ILeagueService LeagueService { get; set; } = default!;

    private bool _hasDataLoaded = false;
    private bool _isViewingTourneys = false;
    private bool _isViewingLeagues = false;

    private List<TournamentDto>? _loadedTournaments = new();
    private List<TournamentDto>? _tournamentsToDisplay = new();

    // Stores tournament id and league name
    private Dictionary<int, string> _leaguesOfTourneys = new();

    private List<LeagueDto>? _loadedLeagues = new();
    private List<TournamentDto>? _leaguesToDisplay = new();

    private List<TournamentDto>? _activeTourneys = new();
    private List<TournamentDto>? _recentTourneys = new();

    protected override async Task OnInitializedAsync()
    {
        _loadedTournaments = (List<TournamentDto>?)await TournamentService.GetAllAsync();

        if (_loadedTournaments!.Any())
        {
            _tournamentsToDisplay = _loadedTournaments!
                .Where
                (
                    t => !t.TournamentCancelled
                    && !t.TournamentStarted
                    && !t.TournamentFinished
                )
                .OrderByDescending(t => t.TournamentDate)
                .ThenByDescending(t => t.TournamentTime)
                .Take(5)
                .ToList();

            _activeTourneys = _loadedTournaments!
                            .Where
                            (
                                t => !t.TournamentCancelled
                                && !t.TournamentStarted
                                && !t.TournamentFinished
                            )
                            .OrderByDescending(t => t.TournamentDate)
                            .ThenByDescending(t => t.TournamentTime)
                            .Take(5)
                            .ToList();

            DateOnly _cutoffDate = DateOnly.FromDateTime(DateTime.Today).AddDays(-14);

            _recentTourneys = _loadedTournaments!
                .Where(t =>
                    !t.TournamentCancelled &&
                    t.TournamentFinished &&
                    t.TournamentDate >= _cutoffDate)
                .OrderByDescending(t => t.TournamentDate)
                .ThenByDescending(t => t.TournamentTime)
                .Take(5)
                .ToList();
        }


        _loadedLeagues = (List<LeagueDto>?)await LeagueService.GetAllAsync();

        foreach (var tournament in _tournamentsToDisplay!)
        {
            if (tournament.TournamentLeague is not null)
            {
                _leaguesOfTourneys[tournament.TournamentId] =
                    (await LeagueService.GetByIdAsync(tournament.TournamentLeague.Value)).LeagueName;
            }
        }

        _hasDataLoaded = true;
    }
}