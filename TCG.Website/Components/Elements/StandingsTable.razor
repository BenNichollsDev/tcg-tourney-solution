@implements IDisposable
@using TCG.Application.Interfaces.Services

<table class="tournament-standings table table-striped">
    <thead>
        <tr>
            <th>Player</th>
            <th>Points</th>
            <th>Wins</th>
            <th>Draws</th>
            <th>Losses</th>
            <th>Game Win %</th>
            <th>Op Win%</th>
        </tr>
    </thead>

    <tbody>
        @* Render all players (active and dropped) in ranking order, then disqualified players *@

        @if (_computedStats != null && _computedStats.Count > 0)
        {
            var allActive = _computedStats
                .Where(p => !p.Value.IsDisqualified)
                .OrderBy(p => p.Value.Position)
                .Select(p => p.Value);

            foreach (var player in allActive)
            {
                var statusSuffix = player.IsDropped ? " (Dropped)" : "";
                var rowClass = player.IsDropped ? "text-muted" : "";

                <tr class="@rowClass">
                    <td>@(player.PlayerName ?? "Unknown")@statusSuffix</td>
                    <td>@player.MatchPoints</td>
                    <td>@player.Wins</td>
                    <td>@player.Draws</td>
                    <td>@player.Losses</td>
                    <td>@player.GameWinPercent.ToString("0.00")</td>
                    <td>@player.OpMatchWinPercent.ToString("0.00")</td>
                </tr>
            }

            var disqualified = _computedStats
                .Where(p => p.Value.IsDisqualified)
                .Select(p => p.Value);

            foreach (var player in disqualified)
            {
                <tr class="text-danger">
                    <td>@(player.PlayerName ?? "Unknown") (Disqualified)</td>
                    <td>N/A</td>
                    <td>N/A</td>
                    <td>N/A</td>
                    <td>N/A</td>
                    <td>N/A</td>
                    <td>N/A</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    // Scoring service to compute current standings
    [Inject]
    private ITournamentScoringService ScoringService { get; set; } = null!;

    // Only pass in the tournament ID when
    // this component is used.
    [Parameter]
    public int TournamentId { get; set; } = new();

    [Parameter]
    public bool RealTimeUpdate { get; set; }

    private Dictionary<int, ITournamentScoringService.PlayerComputedStats> _computedStats = new();

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        if (RealTimeUpdate)
        {
            _cts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));

            await PollForUpdatesAsync(_cts.Token);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await RebuildPlayerListsAsync();
    }

    private async Task PollForUpdatesAsync(CancellationToken token)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(token))
            {
                // Fetch computed standings from the scoring service
                var standingsList = await ScoringService.ComputeTournamentStandings(TournamentId);
                _computedStats = standingsList.FirstOrDefault() ?? new Dictionary<int, ITournamentScoringService.PlayerComputedStats>();

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RebuildPlayerListsAsync()
    {
        // Fetch computed standings from the scoring service
        var standingsList = await ScoringService.ComputeTournamentStandings(TournamentId);
        _computedStats = standingsList.FirstOrDefault() ?? new Dictionary<int, ITournamentScoringService.PlayerComputedStats>();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}