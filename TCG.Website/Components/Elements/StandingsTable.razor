    <thead>
        <tr>
            <th>Player</th>
            <th>Points</th>
            <th>Wins</th>
            <th>Draws</th>
            <th>Losses</th>
            <th>Game Win %</th>
            <th>Op Win%</th>
        </tr>
    </thead>

    <tbody>

        @* Commented out until new tourney rankings function is made *@

        @* @foreach (var player in _activePlayers)
        {
            <tr>
                <td>@(player?.PlayerName ?? "Unknown")</td>
                <td>@player.Points</td>
                <td>@player.Wins</td>
                <td>@player.Draws</td>
                <td>@player.Losses</td>
                <td>@player.GameWinPercent.ToString("0.00")</td>
                <td>@player.OpWinPercent.ToString("0.00")</td>
            </tr>
        }

        
        @foreach (var player in _droppedPlayers)
        {
            <tr>
                <td>@(player?.PlayerName ?? "Unknown")</td>
                <td>@player.Points</td>
                <td>@player.Wins</td>
                <td>@player.Draws</td>
                <td>@player.Losses</td>
                <td>@player.GameWinPercent.ToString("0.00")</td>
