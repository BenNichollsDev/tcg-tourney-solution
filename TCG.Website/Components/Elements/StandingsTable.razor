            </tr>
        }

        @foreach (var player in _disqualifiedPlayers)
        {
            <tr class="text-danger">
                <td>@(player?.PlayerName ?? "Unknown") (Disqualified)</td>
                <td>N/A</td>
                <td>N/A</td>
                <td>N/A</td>
                <td>N/A</td>
                <td>N/A</td>
                <td>N/A</td>
            </tr>
        } *@
    </tbody>
</table>

@code {
    // Scoring service to be used when the current scoring service is fixed
    [Inject]
    private Application.Interfaces.ITournamentScoringService ScoringService { get; set; } = null!;

    // Only pass in the tournament ID when
    // this component is used.
    [Parameter]
    public int TournamentId { get; set; } = new();

    [Parameter]
    public bool RealTimeUpdate { get; set; }

    private Dictionary<int, PlayerComputedStats> _computedStats = new();

    private Dictionary<int, PlayerComputedStats> _activePlayers = new();
    private Dictionary<int, PlayerComputedStats> _droppedPlayers = new();
    private Dictionary<int, PlayerComputedStats> _disqualifiedPlayers = new();

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        if (RealTimeUpdate)
        {
            _cts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));

            await PollForUpdatesAsync(_cts.Token);
        }
    }

    protected override void OnParametersSet()
    {
        RebuildPlayerLists();
    }

    private async Task PollForUpdatesAsync(CancellationToken token)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(token))
            {
                RebuildPlayerLists();

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void RebuildPlayerLists()
    {
        _computedStats = ScoringService.ComputeTournamentStandings(TournamentId);

        _activePlayers = _computedStats
            .Where(p => !p.Value.IsDisqualified && !p.Value.IsDropped)
            .ToDictionary(p => p.Key, p => p.Value);

        _droppedPlayers = _computedStats
            .Where(p => !p.Value.IsDisqualified && p.Value.IsDropped)
            .ToDictionary(p => p.Key, p => p.Value);

        _disqualifiedPlayers = _computedStats
            .Where(p => p.Value.IsDisqualified)
            .ToDictionary(p => p.Key, p => p.Value);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}