@inherits LayoutComponentBase

<div class="page">

    @* /*refend*/ *@

    <NavMenu />

    <main>

        <article class="content flex-grow-1 m-0 p-0">
            @Body
        </article>

    </main>

    <footer>
        <div class="ms-3 me-3">
            <span>
                &copy; 2026 Angels of Cards
            </span>
        </div>
    </footer>
</div>

@* /*refstart*/ *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

