@* refstart *@

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid" style="height: 100%;">
        <a class="navbar-brand" href="">AoC</a>

        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />



        <nav class="nav flex-row navbar-nav">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">

                    @* refend *@

                    <span class="bi" aria-hidden="true"></span> Home

                    @* refstart *@

                </NavLink>
            </div>

            <div class="nav-item px-3">

                @* refend *@

                <NavLink class="nav-link" href="events">
                    <span class="bi" aria-hidden="true"></span> Events
                </NavLink>
            </div>

            <div class="nav-item px-3 ms-auto">
                @if (PlayerSession.IsLoggedIn)
                {
                    <div class="d-flex align-items-center">
                        <span class="navbar-text me-3">Welcome, @PlayerSession.PlayerName</span>
                        <NavLink class="nav-link" href="account">Account</NavLink>
                        <button class="btn btn-sm btn-outline-light" @onclick="Logout">Logout</button>
                    </div>
                }
                else
                {
                    if (CurrentUserId is not null)
                    {
                        <a href="/auth/logout" class="nav-link">
                            <span class="bi" aria-hidden="true"></span> Logout
                        </a>
                    }
                    else
                    {
                        <a href="login-signup" class="nav-link">
                            <span class="bi" aria-hidden="true"></span> Login
                        </a>
                    }
                }
            </div>
        </nav>
    </div>
</div>

@code {
    [CascadingParameter]
    public string? CurrentUserId { get; set; }

    @inject PlayerSessionService PlayerSession
    @inject NavigationManager NavManager
    @inject HttpClient Http

    private async Task Logout()
    {
        try
        {
            await Http.GetAsync("/auth/logout");
            PlayerSession.Logout();
            NavManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout error: {ex.Message}");
        }
    }
}

