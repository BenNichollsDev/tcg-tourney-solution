@* refstart *@

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid" style="height: 100%;">
        <a class="navbar-brand" href="">AoC</a>

        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />



        <nav class="nav flex-row navbar-nav ms-auto" style="width:33%; min-width:220px; justify-content:space-between; align-items:center;">
            <div class="nav-item text-center">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi" aria-hidden="true"></span> Home
                </NavLink>
            </div>

            <div class="nav-item text-center">
                <NavLink class="nav-link" href="events">
                    <span class="bi" aria-hidden="true"></span> Events
                </NavLink>
            </div>

            @if (CurrentUserId is not null)
            {
                <div class="nav-item text-center">
                    <NavLink class="nav-link" href="account">
                        <span class="bi" aria-hidden="true"></span> Account
                    </NavLink>
                </div>

                <div class="nav-item text-center">
                    <a class="nav-link" role="button" @onclick="Logout">Logout</a>
                </div>
            }
            else
            {
                <div class="nav-item text-center">
                    <NavLink class="nav-link" href="login-signup">
                        <span class="bi" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            }
        </nav>
    </div>
</div>

@code {
    [CascadingParameter]
    public string? CurrentUserId { get; set; }


    @inject NavigationManager NavManager
    @inject HttpClient Http

    private async Task Logout()
    {
        try
        {
            await Http.GetAsync("/auth/logout");
            NavManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout error: {ex.Message}");
        }
    }
}

