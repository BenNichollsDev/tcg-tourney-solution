@* refstart *@

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid" style="height: 100%;">
        <a class="navbar-brand" href="">AoC</a>

        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />



        <nav class="nav flex-row navbar-nav">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">

                    @* refend *@

                    <span class="bi" aria-hidden="true"></span> Home

                    @* refstart *@

                </NavLink>
            </div>

            <div class="nav-item px-3">

                @* refend *@

                <NavLink class="nav-link" href="events">
                    <span class="bi" aria-hidden="true"></span> Events
                </NavLink>
            </div>

            <div class="nav-item px-3 ms-auto">
                @if (PlayerSession.IsLoggedIn)
                {
                    <div class="d-flex align-items-center">
                        <span class="navbar-text me-3">Welcome, @PlayerSession.PlayerName</span>
                        <button class="btn btn-sm btn-outline-light" @onclick="Logout">Logout</button>
                    </div>
                }
                else
                {
                    <NavLink class="nav-link" href="login-signup">
                        <span class="bi" aria-hidden="true"></span> Register/Login
                    </NavLink>
                }
            </div>
        </nav>
    </div>
</div>

@code {
    @inject PlayerSessionService PlayerSession
    @inject NavigationManager NavManager

    private void Logout()
    {
        PlayerSession.Logout();
        NavManager.NavigateTo("/");
    }
}
